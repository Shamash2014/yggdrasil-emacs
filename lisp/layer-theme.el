(defface ygg-float '((t))
  "Elevated float background (nvim NormalFloat); posframes/popups read it."
  :group 'faces)

(defun ygg-theme-family (theme)
  "Base family of THEME, `modus' or `foxglove'."
  (nth 1 (assq theme ygg-theme-table)))

(defun ygg-theme-dark-p (theme)
  "Non-nil when THEME is a dark theme."
  (eq (nth 2 (assq theme ygg-theme-table)) 'dark))

(defun ygg-theme-current ()
  "The enabled theme of `ygg-theme-table', or nil."
  (seq-find (lambda (theme) (assq theme ygg-theme-table)) custom-enabled-themes))

(defun ygg-theme-color (key)
  "Colour named KEY in the palette of the enabled theme."
  (modus-themes-get-color-value key t))

(defun ygg-theme--find (family dark)
  "The theme of FAMILY in the dark or light mode."
  (car (seq-find (lambda (row)
                   (and (eq (nth 1 row) family)
                        (eq (eq (nth 2 row) 'dark) dark)))
                 ygg-theme-table)))

(defun ygg-theme--ready-p (theme)
  "Non-nil when the base of THEME can be loaded."
  (or (eq (ygg-theme-family theme) 'modus)
      (require 'foxglove-themes nil t)))

(defun ygg--face (face &rest attrs)
  "Apply ATTRS to FACE when it exists."
  (when (facep face) (apply #'set-face-attribute face nil attrs)))

(defun ygg--magit-theme-tweaks ()
  "Mute magit + diff-hl onto the nvim theme.lua palette (neogit groups)."
  (when (facep 'magit-section-heading)
    (let* ((strong  (ygg-theme-color 'fg-magit-strong))
           (mid     (ygg-theme-color 'fg-magit-mid))
           (muted   (ygg-theme-color 'fg-magit-muted))
           (text    (ygg-theme-color 'fg-magit-text))
           (salient (face-foreground 'success nil t))
           (bg1     (ygg-theme-color 'bg-magit-1))
           (bg2     (ygg-theme-color 'bg-magit-2))
           (bg3     (ygg-theme-color 'bg-magit-3))
           (add-fg  (ygg-theme-color 'fg-added)) (add-bg  (ygg-theme-color 'bg-added))
           (add-bg2 (ygg-theme-color 'bg-magit-added-hl))
           (chg-fg  (ygg-theme-color 'fg-changed))
           (del-fg  (ygg-theme-color 'fg-removed)) (del-bg  (ygg-theme-color 'bg-removed))
           (del-bg2 (ygg-theme-color 'bg-magit-removed-hl)))
      (ygg--face 'magit-section-heading :foreground strong :weight 'bold :background 'unspecified)
      (ygg--face 'magit-section-secondary-heading :foreground mid :weight 'normal)
      (ygg--face 'magit-section-heading-selection :foreground chg-fg)
      (ygg--face 'magit-section-highlight :background bg1)
      (ygg--face 'magit-diff-context :foreground text :background 'unspecified)
      (ygg--face 'magit-diff-context-highlight :foreground text :background bg1)
      (ygg--face 'magit-diff-added :foreground add-fg :background add-bg)
      (ygg--face 'magit-diff-added-highlight :foreground add-fg :background add-bg2)
      (ygg--face 'magit-diff-removed :foreground del-fg :background del-bg)
      (ygg--face 'magit-diff-removed-highlight :foreground del-fg :background del-bg2)
      (ygg--face 'magit-diff-hunk-heading :foreground mid :background bg1 :weight 'normal)
      (ygg--face 'magit-diff-hunk-heading-highlight :foreground strong :background bg2 :weight 'bold)
      (ygg--face 'magit-diff-hunk-heading-selection :foreground strong :background bg3)
      (ygg--face 'magit-diff-file-heading :foreground strong :weight 'bold :background 'unspecified)
      (ygg--face 'magit-diff-file-heading-highlight :foreground strong :background bg1 :weight 'bold)
      (ygg--face 'magit-diff-lines-heading :foreground strong :background bg2)
      (ygg--face 'magit-diffstat-added :foreground add-fg)
      (ygg--face 'magit-diffstat-removed :foreground del-fg)
      (ygg--face 'magit-branch-local :foreground salient :weight 'bold)
      (ygg--face 'magit-branch-current :foreground salient :weight 'bold :box nil)
      (ygg--face 'magit-branch-remote :foreground mid :weight 'bold)
      (ygg--face 'magit-head :foreground salient)
      (ygg--face 'magit-tag :foreground chg-fg)
      (ygg--face 'magit-refname :foreground muted)
      (ygg--face 'magit-hash :foreground muted)
      (ygg--face 'magit-log-author :foreground mid)
      (ygg--face 'magit-log-date :foreground muted)
      (ygg--face 'magit-log-graph :foreground muted)
      (ygg--face 'magit-dimmed :foreground muted)
      (ygg--face 'magit-filename :foreground text)
      (ygg--face 'magit-header-line :foreground strong :weight 'bold :background 'unspecified)
      (ygg--face 'diff-hl-insert :foreground add-fg :background 'unspecified)
      (ygg--face 'diff-hl-change :foreground chg-fg :background 'unspecified)
      (ygg--face 'diff-hl-delete :foreground del-fg :background 'unspecified))))


(defun ygg--theme-tweaks (&rest _)
  "Face details the modus palette can't express (matches nvim theme.lua)."
  (when-let* ((theme (ygg-theme-current)))
    (let* ((dark (ygg-theme-dark-p theme))
           (float-bg (ygg-theme-color 'bg-float))
           (float-edge (ygg-theme-color 'border-float))
           (bar-bg (ygg-theme-color 'bg-main)))
      ;; paper reads thin; its greys live in the palette, out of new dark frames
      (ygg--face 'default :weight (if dark 'regular 'medium))
      (ygg--face 'font-lock-comment-face :slant 'italic)
      (ygg--face 'font-lock-function-name-face :weight 'bold)
      (ygg--face 'font-lock-keyword-face :weight 'bold)
      (dolist (face '(font-lock-operator-face font-lock-punctuation-face))
        (ygg--face face :foreground (ygg-theme-color 'fg-operator)))
      (ygg--face 'isearch
                 :background (ygg-theme-color 'bg-isearch)
                 :foreground (ygg-theme-color 'fg-isearch))
      (ygg--face 'lazy-highlight
                 :background (ygg-theme-color 'bg-lazy)
                 :foreground (ygg-theme-color 'fg-lazy))
      (ygg--face 'ygg-float :background float-bg)
      (ygg--face 'ygg-task-tree--row-highlight
                 :inherit 'unspecified :extend t
                 :background (ygg-theme-color 'bg-task-row))
      (ygg--face 'ygg-task-tree--dim :foreground (ygg-theme-color 'fg-task-dim))
      (ygg--face 'ygg-task-tree--heading
                 :foreground (ygg-theme-color 'fg-task-heading) :weight 'normal)
      (ygg--face 'ygg-task-tree--primary
                 :foreground (ygg-theme-color 'fg-task-primary) :weight 'bold)
      (ygg--face 'ygg-task-tree--accent :foreground (ygg-theme-color 'fg-task-accent))
      (ygg--face 'ygg-focus-dim :foreground (ygg-theme-color 'fg-focus-dim))
      ;; margins take the default background, so on dark a fringe band floats mid-gutter
      (ygg--face 'ygg-focus-border
                 :background (if dark (face-background 'default nil t) float-bg))
      (let ((divider (ygg-theme-color 'border-divider)))
        (dolist (face '(window-divider window-divider-first-pixel window-divider-last-pixel))
          (ygg--face face :foreground divider))
        (ygg--face 'internal-border :background (face-attribute 'default :background nil t))
        (ygg--face 'child-frame-border :background float-edge))
      (setq window-divider-default-places t
            window-divider-default-bottom-width 1
            window-divider-default-right-width 1)
      (dolist (frame (frame-list))
        (set-frame-parameter frame 'internal-border-width 4))
      (setf (alist-get 'internal-border-width default-frame-alist) 4)
      (fringe-mode '(4 . 4))
      (when (fboundp 'window-divider-mode)
        (window-divider-mode 1))
      (dolist (face '(vertico-posframe which-key-posframe corfu-default))
        (ygg--face face :background float-bg))
      (dolist (face '(vertico-posframe-border which-key-posframe-border corfu-border))
        (ygg--face face :background float-edge))
      (ygg--face 'corfu-current :background (ygg-theme-color 'bg-corfu-current) :weight 'bold)
      (ygg--face 'doom-modeline-bar :background (ygg-theme-color 'bg-modeline-bar))
      (ygg--face 'mode-line
                 :background bar-bg
                 :foreground (ygg-theme-color 'fg-modeline)
                 :box nil :overline (ygg-theme-color 'border)
                 :underline nil)
      (ygg--face 'mode-line-active :inherit 'mode-line
                 :background 'unspecified :foreground 'unspecified
                 :box nil :overline 'unspecified :underline nil)
      (ygg--face 'mode-line-inactive
                 :background bar-bg
                 :foreground (ygg-theme-color 'fg-mode-line-inactive)
                 :box nil :overline (ygg-theme-color 'border)
                 :underline nil)
      (ygg--face 'doom-modeline-bar-inactive :background bar-bg)
      (ygg--face 'doom-modeline-buffer-modified
                 :foreground (ygg-theme-color 'fg-modeline-strong)
                 :weight 'bold :slant 'italic)
      (ygg--face 'doom-modeline-buffer-file
                 :foreground (ygg-theme-color 'fg-modeline-strong) :weight 'bold)
      (ygg--face 'doom-modeline-minor-mode
                 :foreground (ygg-theme-color 'fg-modeline-minor))
      (dolist (face '(doom-modeline-emphasis doom-modeline-vcs-default doom-modeline-info))
        (ygg--face face :foreground 'unspecified :inherit 'unspecified
                   :slant 'normal :weight 'bold))
      (ygg--magit-theme-tweaks))))

(add-hook 'enable-theme-functions #'ygg--theme-tweaks)
;; packages that define faces after the theme loads need a re-run
(dolist (pkg '(corfu doom-modeline vertico-posframe which-key-posframe magit diff-hl))
  (with-eval-after-load pkg (ygg--theme-tweaks)))

(defun ygg-theme-saved ()
  "The theme chosen last time, light modus when none was."
  (or (ignore-errors
        (with-temp-buffer
          (insert-file-contents ygg-theme-file)
          (car (assq (intern (string-trim (buffer-string))) ygg-theme-table))))
      'modus-operandi))

(defun ygg-theme--enable (theme)
  "Make THEME the only enabled theme, on the palette of its mode."
  (let ((palette (if (ygg-theme-dark-p theme) ygg-theme-palette-dark ygg-theme-palette-light)))
    (when (eq (ygg-theme-family theme) 'foxglove)
      (setq foxglove-themes-palette-overrides palette))
    (mapc #'disable-theme custom-enabled-themes)
    (load-theme theme t)))

(defun ygg-theme--show (theme)
  "Enable THEME, or the modus theme of its mode while its base is missing."
  (ygg-theme--enable (if (ygg-theme--ready-p theme)
                         theme
                       (ygg-theme--find 'modus (ygg-theme-dark-p theme)))))

(defun ygg-theme-set (theme)
  "Switch to THEME and remember it for the next start."
  (ygg-theme--show theme)
  (make-directory (file-name-directory ygg-theme-file) t)
  (write-region (symbol-name theme) nil ygg-theme-file nil 'silent))

(defun ygg-theme-load-saved ()
  "Show the saved theme unless it is the enabled one already."
  (let ((theme (ygg-theme-saved)))
    (unless (eq theme (ygg-theme-current))
      (ygg-theme--show theme))))

(defun ygg-theme--source ()
  "The theme T and B start from: the saved one while its base is missing."
  (let ((saved (ygg-theme-saved)))
    (if (ygg-theme--ready-p saved)
        (or (ygg-theme-current) saved)
      saved)))

(defun ygg-theme-toggle ()
  "Flip between the light and the dark theme of the chosen base."
  (interactive)
  (let ((theme (ygg-theme--source)))
    (ygg-theme-set (ygg-theme--find (ygg-theme-family theme) (not (ygg-theme-dark-p theme))))))

(defun ygg-theme-switch-base ()
  "Switch between the modus and the foxglove base, keeping light or dark."
  (interactive)
  (let* ((theme (ygg-theme--source))
         (target (ygg-theme--find (if (eq (ygg-theme-family theme) 'modus) 'foxglove 'modus)
                                  (ygg-theme-dark-p theme))))
    (unless (ygg-theme--ready-p target)
      (user-error "Foxglove themes are not installed"))
    (ygg-theme-set target)))

(setq modus-operandi-palette-overrides ygg-theme-palette-light
      modus-vivendi-palette-overrides ygg-theme-palette-dark)

(ygg-theme-load-saved)
(when (fboundp 'elpaca)
  (with-no-warnings
    (elpaca (foxglove-themes :host gitlab :repo "vegasharmon/foxglove-themes")
      (ygg-theme-load-saved))))

(with-eval-after-load 'layer-terminal
  (yggdrasil-define-keys 'ygg-leader-open-map
    "T" #'ygg-theme-toggle :label "theme light ⇄ dark"
    "B" #'ygg-theme-switch-base :label "theme modus ⇄ foxglove"))

(provide 'layer-theme)
