#!/usr/bin/env node
import { execFileSync } from "node:child_process";
import { createRequire } from "node:module";
import { existsSync, mkdirSync, readFileSync, realpathSync, statSync, writeFileSync } from "node:fs";
import { basename, dirname, extname, join, relative, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { compare, listFiles, stripSource } from "./ice-core.mjs";

const HELP = `usage: ice-repo-map [--root DIR] [--budget TOKENS] [--focus FILE]... [--mention IDENT]... [--write | --json]

Ranks the symbols of a repository by who references them (PageRank over a
file reference graph, aider style) and prints the top ones as markdown that
fits --budget tokens (ceil(chars/2.5), about wordpiece tokens; default and maximum 2000).

--write puts the full map, every file with definitions and all its symbols
and no budget, in lat.md/repo-map.md and lists it in lat.md/lat.md.
--json prints the ranked files and definitions instead.
--focus FILE personalizes the ranking towards FILE; --mention IDENT boosts
an identifier. The lat package is found from the lat on PATH, or ICE_LAT_PKG;
without it only elisp files are mapped.`;

const INDEX_LINE = "- [[repo-map]] — ranked repo map: key files and symbols, generated by ice-repo-map <!-- ice-repo-map:generated -->";
const LEGACY_INDEX_LINE = "- [[repo-map]] — ranked repo map: key files and symbols, generated by ice-repo-map <!-- GENERATED -->";
const LAT_EXTENSIONS = new Set([".ts", ".tsx", ".js", ".jsx", ".py", ".rs", ".go", ".c", ".h"]);
const EXTENSIONS = new Set([...LAT_EXTENSIONS, ".dart", ".el"]);
const LANGUAGE = { ".tsx": "js", ".ts": "js", ".jsx": "js", ".js": "js", ".h": "c" };
const MAX_BYTES = 512 * 1024;
const GENERATED_NAME = /\.(min\.js|g\.dart|freezed\.dart|pb\.go|generated\.\w+)$|-autoloads\.el$|(^|\/)loaddefs\.el$/;
const GENERATED_HEAD = /@generated|do not edit|code generated|auto-?generated/i;
const MIN_NAME = 3;
const DAMPING = 0.85;
const ITERATIONS = 30;
const SIGNATURE_MAX = 100;
const PARAGRAPH_MAX = 240;
const MAX_BUDGET = 2000;
const FOCUS_BOOST = 10;
const TEST_PATH = /(^|\/)tests?\/|-tests?\.el$|_test\.[^/]+$|\.test\.[^/]+$|(^|\/)test_[^/]*\.py$/;
const DAMPENED_KINDS = new Set(["group", "face"]);
const CHUNK_TOKENS = 128;
const CHARS_PER_TOKEN = 2.5;
const CHUNK_ANCHOR = 3;
const CHUNK_SIGNATURE_MAX = 60;
const LEAD_MAX = 250;
const TOP_DEFS = 10;
const GROUPS = [
  ["Functions", ["function", "generic", "alias", "getter", "setter", "constructor"]],
  ["Variables and options", ["variable", "constant", "const", "option"]],
  ["Faces and groups", ["face", "group"]],
  ["Macros", ["macro"]],
  ["Modes and keymaps", ["mode", "keymap"]],
  ["Transients", ["transient"]],
  ["Classes and types", ["class", "struct", "enum", "mixin", "extension", "typedef", "interface", "type"]],
  ["Methods", ["method"]],
];
const OTHER_GROUP = "Other";
const ELISP_FEATURE_FORM = /\((?:require|provide|featurep)\s+'[^\s()]+/g;

const ELISP_KINDS = {
  defun: "function", "cl-defun": "function", defsubst: "function", "cl-defsubst": "function",
  defmacro: "macro", "cl-defmacro": "macro",
  defvar: "variable", "defvar-local": "variable", defconst: "constant", defcustom: "option",
  defface: "face", defgroup: "group", "cl-defgeneric": "generic", "cl-defmethod": "method",
  "cl-defstruct": "struct", defclass: "class", defalias: "alias", "defvar-keymap": "keymap",
  "define-minor-mode": "mode", "define-derived-mode": "mode", "define-globalized-minor-mode": "mode",
  "transient-define-prefix": "transient", "transient-define-suffix": "transient",
  "transient-define-infix": "transient", "transient-define-argument": "transient",
};
const ELISP_HEAD = new RegExp(`(${Object.keys(ELISP_KINDS).join("|")})\\s+(\\(setf\\s+[^\\s()]+\\)|(?:['(]\\s*)?[^\\s()'"]+)`, "y");
const ELISP_WRAPPER = /(?:progn|eval-and-compile|eval-when-compile|with-eval-after-load|when|unless|if)[\s)]/y;
const ELISP_FORWARD_DECLARATION = /^\(defvar(?:-local)?\s+[^\s()]+\s*\)/;
const ELISP_IDENT = /[A-Za-z_][\w\-/:*?!<>=+]*/g;
const PLAIN_IDENT = /[A-Za-z_$][\w$]*/g;

process.stdout.on("error", (error) => process.exit(error.code === "EPIPE" ? 0 : 1));

function fail(message, code = 2) {
  process.stderr.write(`ice-repo-map: ${message}\n`);
  process.exit(code);
}

function parseArgs(argv) {
  const opts = { root: null, budget: MAX_BUDGET, focus: [], mention: [], write: false, json: false };
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    const value = () => (i + 1 < argv.length ? argv[++i] : fail(`${arg} needs a value`));
    if (arg === "--root") opts.root = value();
    else if (arg === "--budget") opts.budget = Number(value());
    else if (arg === "--focus") opts.focus.push(value());
    else if (arg === "--mention") opts.mention.push(value());
    else if (arg === "--write") opts.write = true;
    else if (arg === "--json") opts.json = true;
    else if (arg === "-h" || arg === "--help") {
      process.stdout.write(`${HELP}\n`);
      process.exit(0);
    } else fail(`unknown argument ${arg}\n${HELP}`);
  }
  if (!Number.isFinite(opts.budget) || opts.budget <= 0) fail("--budget must be a positive number");
  opts.budget = Math.min(opts.budget, MAX_BUDGET);
  if (opts.write && opts.json) fail("--write and --json exclude each other");
  return opts;
}

function resolveRoot(root) {
  try {
    const dir = realpathSync(root ?? execFileSync("git", ["rev-parse", "--show-toplevel"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim());
    execFileSync("git", ["-C", dir, "rev-parse", "--is-inside-work-tree"], { stdio: "ignore" });
    return dir;
  } catch {
    return fail("not inside a git repository; pass --root");
  }
}

function looksGenerated(path, text) {
  if (GENERATED_NAME.test(path)) return true;
  const lines = text.split("\n");
  if (GENERATED_HEAD.test(lines.slice(0, 5).join("\n"))) return true;
  return text.length > 2048 && (lines.some((line) => line.length > 1000) || text.length / lines.length > 200);
}

function readSources(root) {
  const sources = [];
  for (const path of listFiles(root)) {
    if (path.startsWith("lat.md/") || !EXTENSIONS.has(extname(path))) continue;
    const full = join(root, path);
    if (!existsSync(full)) continue;
    const stat = statSync(full);
    if (!stat.isFile() || stat.size > MAX_BYTES) continue;
    const text = readFileSync(full, "utf8");
    if (!looksGenerated(path, text)) sources.push({ path, text });
  }
  return sources;
}

function firstLine(text) {
  return text.split("\n")[0].trim();
}

function elispDefs(text) {
  const defs = [];
  const stack = [];
  let line = 1;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (c === "\n") line++;
    else if (c === ";") i = text.indexOf("\n", i) < 0 ? text.length : text.indexOf("\n", i) - 1;
    else if (c === "\\") i++;
    else if (c === "?" && !/[\w-]/.test(text[i - 1] ?? " ")) i += text[i + 1] === "\\" ? 2 : 1;
    else if (c === '"') {
      for (i++; i < text.length && text[i] !== '"'; i++) {
        if (text[i] === "\\") i++;
        else if (text[i] === "\n") line++;
      }
    } else if (c === "(") {
      const entry = { wrapper: false, def: null };
      if (stack.every((outer) => outer.wrapper)) {
        ELISP_HEAD.lastIndex = i + 1;
        ELISP_WRAPPER.lastIndex = i + 1;
        const head = ELISP_HEAD.exec(text);
        const sig = closeUnbalanced(firstLine(text.slice(i, i + 400)));
        if (head && !ELISP_FORWARD_DECLARATION.test(sig)) {
          entry.def = { name: head[2].replace(/\s+/g, " "), kind: ELISP_KINDS[head[1]], startLine: line, endLine: line, signature: sig };
          defs.push(entry.def);
        } else entry.wrapper = ELISP_WRAPPER.test(text);
      }
      stack.push(entry);
    } else if (c === ")") {
      const entry = stack.pop();
      if (entry?.def) entry.def.endLine = line;
    }
  }
  return defs;
}

function closeUnbalanced(signature) {
  let depth = 0;
  for (let i = 0; i < signature.length; i++) {
    if (signature[i] === "(") depth++;
    else if (signature[i] === ")" && --depth < 0) return signature.slice(0, i).trimEnd();
  }
  return signature;
}

function elispSummary(text) {
  const match = text.match(/^;;;\s+\S+\.el\s+---.*$/m);
  return match ? `\`${sanitizeParagraph(match[0].replace(/\s*-\*-.*$/, ""), PARAGRAPH_MAX - 2)}\`` : null;
}

function stripElisp(text) {
  let out = "";
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (c === ";") {
      const end = text.indexOf("\n", i);
      i = end < 0 ? text.length : end - 1;
      out += " ";
    } else if (c === "\\") {
      i++;
      out += "  ";
    } else if (c === "?" && !/[\w-]/.test(text[i - 1] ?? " ")) {
      i += text[i + 1] === "\\" ? 2 : 1;
      out += " ";
    } else if (c === '"') {
      for (i++; i < text.length && text[i] !== '"'; i++) if (text[i] === "\\") i++;
      out += " ";
    } else out += c;
  }
  return out.replace(ELISP_FEATURE_FORM, " ");
}

function dartSymbols(root) {
  const symbols = [];
  const named = (node) => node.childForFieldName("name") ?? node.namedChildren.find((child) => child.type === "identifier");
  const push = (node, name, kind, parent, end = node) => {
    if (!name) return;
    symbols.push({
      name, kind, ...(parent ? { parent } : {}),
      startLine: node.startPosition.row + 1, endLine: end.endPosition.row + 1, signature: firstLine(node.text),
    });
  };
  const dotted = (node) => node.namedChildren.filter((child) => child.type === "identifier").map((child) => child.text).join(".");
  const members = (body, parent) => {
    const children = body.namedChildren;
    children.forEach((member, i) => {
      const after = children[i + 1]?.type === "function_body" ? children[i + 1] : member;
      const inner = member.namedChildren.find((child) => /^(function|getter|setter|factory_constructor|constant_constructor|constructor)_signature$/.test(child.type));
      if (!inner || !/^(method_signature|declaration)$/.test(member.type)) return;
      if (/constructor/.test(inner.type)) push(member, dotted(inner), "constructor", parent, after);
      else push(member, named(inner)?.text, inner.type.replace("_signature", ""), parent, after);
    });
  };
  const kinds = { class_definition: "class", enum_declaration: "enum", mixin_declaration: "mixin", extension_declaration: "extension" };
  const nodes = root.namedChildren;
  nodes.forEach((node, i) => {
    if (kinds[node.type]) {
      const name = node.namedChildren.find((child) => child.type === "identifier")?.text;
      const on = node.namedChildren.find((child) => child.type === "type_identifier")?.text;
      push(node, name, kinds[node.type]);
      const body = node.namedChildren.find((child) => /_body$/.test(child.type));
      const parent = name ?? (node.type === "extension_declaration" && on ? `extension on ${on}` : null);
      if (parent && body) members(body, parent);
    } else if (/^(function|getter|setter)_signature$/.test(node.type)) {
      push(node, named(node)?.text, node.type.replace("_signature", ""), null, nodes[i + 1]?.type === "function_body" ? nodes[i + 1] : node);
    } else if (node.type === "type_alias") {
      const ids = node.namedChildren.filter((child) => child.type === "type_identifier");
      const callable = node.namedChildren.some((child) => child.type === "formal_parameter_list");
      push(node, (callable ? ids[ids.length - 1] : ids[0])?.text, "typedef");
    } else if (node.type === "static_final_declaration_list") {
      for (const decl of node.namedChildren) push(node, named(decl)?.text, "constant");
    }
  });
  return symbols;
}

function findLatPackage(start) {
  for (let dir = start; dirname(dir) !== dir; dir = dirname(dir)) {
    const manifest = join(dir, "package.json");
    if (existsSync(manifest) && JSON.parse(readFileSync(manifest, "utf8")).name === "lat.md") return dir;
  }
  return null;
}

async function loadLat() {
  let pkg = process.env.ICE_LAT_PKG;
  if (!pkg) {
    let bin;
    try {
      bin = execFileSync("sh", ["-c", "command -v lat"], { encoding: "utf8" }).trim();
    } catch {
      return null;
    }
    const real = realpathSync(bin);
    const shim = readFileSync(real, "utf8").slice(0, 400).match(/target=(\S+)/)?.[1];
    const starts = [shim && resolve(dirname(real), shim), real, join(dirname(real), "../lat.md")].filter(Boolean);
    pkg = starts.map(findLatPackage).find(Boolean);
    if (!pkg) return null;
  }
  try {
    pkg = realpathSync(pkg);
    const need = createRequire(join(pkg, "package.json"));
    const { Parser, Language } = await import(pathToFileURL(need.resolve("web-tree-sitter").replace(/\.cjs$/, ".js")).href);
    const { parseSourceSymbols } = await import(pathToFileURL(join(pkg, "dist/src/source-parser.js")).href);
    await Parser.init();
    const parser = new Parser();
    parser.setLanguage(await Language.load(join(dirname(need.resolve("@repomix/tree-sitter-wasms/package.json")), "out/tree-sitter-dart.wasm")));
    const parseDart = (text) => {
      const tree = parser.parse(text);
      try {
        return dartSymbols(tree.rootNode);
      } finally {
        tree.delete();
      }
    };
    return { parseSourceSymbols, parseDart };
  } catch {
    return fail(`cannot load the lat.md package at ${pkg}; fix ICE_LAT_PKG or the lat install`);
  }
}

function docParagraph(text) {
  const lines = text.split("\n").slice(0, 80);
  let i = 0;
  while (i < lines.length && (/^#!/.test(lines[i]) || !lines[i].trim())) i++;
  const first = (lines[i] ?? "").trim();
  const body = [];
  if (/^\/\*/.test(first)) {
    for (; i < lines.length; i++) {
      body.push(lines[i].replace(/^\s*(\/\*+|\*+\/?)/, "").replace(/\*+\/\s*$/, ""));
      if (/\*\//.test(lines[i])) break;
    }
  } else if (/^("""|''')/.test(first)) {
    const quote = first.slice(0, 3);
    for (let j = 0; i < lines.length; i++, j++) {
      body.push(lines[i].replace(j ? "" : quote, "").replace(quote, ""));
      if (lines[i].indexOf(quote, j ? 0 : 3) >= 0) break;
    }
  } else if (/^(\/\/|#)/.test(first)) {
    for (; i < lines.length && /^\s*(\/\/|#)/.test(lines[i]); i++) body.push(lines[i].replace(/^\s*(\/\/[/!]?|#+)/, ""));
  }
  const paragraph = body.join("\n").trim().split(/\n\s*\n/)[0] ?? "";
  return /copyright|license|spdx/i.test(paragraph) ? "" : paragraph;
}

function sanitizeParagraph(text, max = PARAGRAPH_MAX) {
  const plain = text.replace(/\[\[|\]\]/g, "").replace(/`/g, "'").replace(/\s+/g, " ").replace(/^[-*+#>|\d.\s]+/, "").trim();
  return plain.length > max ? `${plain.slice(0, max - 3)}...` : plain;
}

function fileSummary(source, defCount) {
  const raw = extname(source.path) === ".el" ? elispSummary(source.text) : sanitizeParagraph(docParagraph(source.text));
  return raw || `Defines ${defCount} ${defCount === 1 ? "symbol" : "symbols"}.`;
}

async function extractDefs(sources) {
  let lat = null;
  let loaded = false;
  const files = [];
  for (const source of sources) {
    const ext = extname(source.path);
    let defs = [];
    if (ext === ".el") defs = elispDefs(source.text);
    else {
      if (!loaded) {
        loaded = true;
        lat = await loadLat();
        if (!lat) process.stderr.write("ice-repo-map: lat was not found, skipping files that are not elisp; install lat.md or set ICE_LAT_PKG\n");
      }
      if (!lat) continue;
      try {
        defs = ext === ".dart" ? lat.parseDart(source.text) : await lat.parseSourceSymbols(source.path, source.text);
      } catch {
        defs = [];
      }
    }
    files.push({
      path: source.path, ext, language: LANGUAGE[ext] ?? ext, text: source.text,
      defs: defs.map((def) => ({ ...def, path: source.path })),
      summary: fileSummary(source, defs.length),
    });
  }
  return files;
}

function referenceCounts(file) {
  const counts = new Map();
  const code = file.ext === ".el" ? stripElisp(file.text) : stripSource(file.text, file.language);
  for (const name of code.match(file.ext === ".el" ? ELISP_IDENT : PLAIN_IDENT) ?? []) {
    counts.set(name, (counts.get(name) ?? 0) + 1);
  }
  return counts;
}

function multiplier(name, definerCount, mentions) {
  let factor = 1;
  if (name.length >= 8 && /[-_]|[a-z][A-Z]/.test(name)) factor *= 10;
  if (name.startsWith("_") || name.includes("--")) factor *= 0.1;
  if (definerCount > 5) factor *= 0.1;
  if (mentions.has(name)) factor *= 10;
  return factor;
}

function pageRank(files, edges, focus) {
  const size = files.length;
  const personal = files.map((file) => (focus.size ? (focus.has(file.path) ? 1 / focus.size : 0) : 1 / size));
  const outWeight = edges.map((out) => [...out.values()].reduce((sum, w) => sum + w, 0));
  let rank = personal.slice();
  for (let step = 0; step < ITERATIONS; step++) {
    const next = personal.map((p) => (1 - DAMPING) * p);
    let dangling = 0;
    rank.forEach((value, a) => {
      if (!outWeight[a]) dangling += value;
      else for (const [b, w] of edges[a]) next[b] += (DAMPING * value * w) / outWeight[a];
    });
    next.forEach((_, i) => (next[i] += DAMPING * dangling * personal[i]));
    const total = next.reduce((sum, v) => sum + v, 0);
    rank = next.map((v) => v / total);
  }
  return { rank, outWeight };
}

function rankFiles(files, opts) {
  const mentions = new Set(opts.mention);
  const focus = new Set(opts.focus);
  const definers = new Map();
  files.forEach((file, index) => {
    for (const def of file.defs) {
      if (def.name.length < MIN_NAME) continue;
      const key = `${file.language}\0${def.name}`;
      if (!definers.has(key)) definers.set(key, new Set());
      definers.get(key).add(index);
    }
  });
  const generics = new Set(files.flatMap((file) => file.defs).filter((def) => def.kind === "generic").map((def) => def.name));
  const edges = files.map(() => new Map());
  const parts = files.map(() => []);
  files.forEach((file, a) => {
    for (const [name, count] of referenceCounts(file)) {
      const owners = definers.get(`${file.language}\0${name}`);
      if (!owners) continue;
      for (const b of owners) {
        if (b === a) continue;
        const boost = focus.has(file.path) || focus.has(files[b].path) ? FOCUS_BOOST : 1;
        const weight = Math.sqrt(count) * multiplier(name, owners.size, mentions) * boost;
        edges[a].set(b, (edges[a].get(b) ?? 0) + weight);
        parts[a].push({ b, name, weight });
      }
    }
  });
  const { rank, outWeight } = pageRank(files, edges, focus);
  const flow = new Map();
  parts.forEach((list, a) => {
    for (const { b, name, weight } of list) {
      const key = `${b}\0${name}`;
      flow.set(key, (flow.get(key) ?? 0) + (rank[a] * weight) / outWeight[a]);
    }
  });
  const ranked = files.map((file, index) => {
    const defs = file.defs.map((def) => {
      const owners = definers.get(`${file.language}\0${def.name}`)?.size ?? 1;
      const base = (flow.get(`${index}\0${def.name}`) ?? 0) / owners + (0.01 * rank[index]) / file.defs.length;
      return { ...def, rank: base * dampening(def, file.path, generics) };
    });
    defs.sort(byDef);
    return { ...file, defs, fileRank: rank[index] };
  });
  return ranked
    .filter((file) => file.defs.length)
    .sort((x, y) => y.fileRank - x.fileRank || compare(x.path, y.path));
}

function dampening(def, path, generics) {
  let factor = 1;
  if (DAMPENED_KINDS.has(def.kind)) factor *= 0.2;
  if (TEST_PATH.test(path)) factor *= 0.1;
  if (path.endsWith(".el")) {
    if (def.name.includes("--")) factor *= 0.3;
    if (def.kind === "method" && !generics.has(def.name)) factor *= 0.2;
  }
  return factor;
}

function byDef(x, y) {
  return y.rank - x.rank || compare(x.path, y.path) || x.startLine - y.startLine || compare(x.name, y.name);
}

function trimSignature(signature, max = SIGNATURE_MAX) {
  const plain = signature.replace(/`/g, "'").replace(/\[(?=\[)/g, "[ ").replace(/\](?=\])/g, "] ").replace(/\s+/g, " ").trim();
  return plain.length > max ? `${plain.slice(0, max - 3)}...` : plain;
}

function defLine(def, ext) {
  const text = `${def.kind}: ${trimSignature(def.signature)}`;
  const linkable = LAT_EXTENSIONS.has(ext) && /^[\w$]+$/.test(def.name) && /^[\w./-]+$/.test(def.path) && (!def.parent || /^[\w$]+$/.test(def.parent));
  if (linkable) return `- [[${def.path}#${def.parent ? `${def.parent}#` : ""}${def.name}]] — ${text}`;
  return `- \`${def.name.replace(/`/g, "'")}\` (${def.path}:${def.startLine}) — ${text}`;
}

function render(files, intro, keep) {
  const blocks = ["# Repo map", intro];
  for (const file of files) {
    const defs = file.defs.filter((def) => keep.has(def));
    if (!defs.length) continue;
    blocks.push(`## ${file.path}`, file.summary, defs.map((def) => defLine(def, file.ext)).join("\n"));
  }
  return `${blocks.join("\n\n")}\n`;
}

function estimateTokens(text) {
  return Math.ceil(text.length / CHARS_PER_TOKEN);
}

function chunkLine(def) {
  return `- \`${def.name.replace(/`/g, "'")}\` — ${def.kind}: ${trimSignature(def.signature, CHUNK_SIGNATURE_MAX)}`;
}

function chunkSection(file, title, defs, label = title) {
  const raw = `${title}: ${defs.map((def) => def.name).join(", ")}.`;
  return {
    heading: `## ${file.path} · ${label}`,
    lead: sanitizeParagraph(raw, LEAD_MAX),
    fits: sanitizeParagraph(raw, Infinity).length <= LEAD_MAX,
    lines: defs.map(chunkLine).join("\n"),
  };
}

function chunkFits(section) {
  return section.fits && estimateTokens([section.heading, section.lead, section.lines].join("\n\n")) <= CHUNK_TOKENS;
}

function endsChunk(def) {
  let hash = 2166136261;
  for (const char of def.name) hash = Math.imul(hash ^ char.codePointAt(0), 16777619);
  return (hash >>> 0) % CHUNK_ANCHOR === 0;
}

function chunkGroups(file, title, members) {
  const groups = [];
  for (let start = 0; start < members.length; ) {
    let end = start + 1;
    while (end < members.length && !endsChunk(members[end - 1]) && chunkFits(chunkSection(file, title, members.slice(start, end + 1), `${title} · ${members[start].name} 2`))) end++;
    groups.push(members.slice(start, end));
    start = end;
  }
  return groups;
}

function chunkBlocks(file) {
  const blocks = [];
  const known = new Set(GROUPS.flatMap(([, kinds]) => kinds));
  for (const [title, kinds] of [...GROUPS, [OTHER_GROUP, null]]) {
    const members = file.defs
      .filter((def) => (kinds ? kinds.includes(def.kind) : !known.has(def.kind)))
      .sort((x, y) => x.startLine - y.startLine);
    const groups = chunkGroups(file, title, members);
    const labels = new Set();
    for (const defs of groups) {
      let label = groups.length > 1 ? `${title} · ${defs[0].name.replace(/[`\[\]]/g, "'")}` : title;
      for (let n = 2; labels.has(label); n++) label = `${label.replace(/ \d+$/, "")} ${n}`;
      labels.add(label);
      const section = chunkSection(file, title, defs, label);
      blocks.push(section.heading, section.lead, section.lines);
    }
  }
  return blocks;
}

function fileBlocks(file) {
  const head = [`## ${file.path}`, file.summary];
  const top = [];
  for (const def of file.defs.slice(0, TOP_DEFS)) {
    if (estimateTokens([...head, ...top, chunkLine(def)].join("\n\n")) > CHUNK_TOKENS) break;
    top.push(chunkLine(def));
  }
  return [...head, ...(top.length ? [top.join("\n")] : []), ...chunkBlocks(file)];
}

function renderFull(files) {
  const blocks = ["# Repo map", "Ranked repo map: every file with definitions, ordered by how much of the code references it, with all its symbols. Generated by ice-repo-map; rerun it to refresh."];
  for (const file of files) blocks.push(...fileBlocks(file));
  return `${blocks.join("\n\n")}\n`;
}

const FIT_MARGIN = 0.97;

function fit(files, budget) {
  const intro = `Ranked repo map: the key files and symbols, ordered by how much of the code references them. Generated by ice-repo-map with a ${budget} token budget; rerun it to refresh.`;
  const ranked = files.flatMap((file) => file.defs).sort(byDef);
  const build = (count) => render(files, intro, new Set(ranked.slice(0, count)));
  const target = Math.floor(budget * FIT_MARGIN);
  let low = 0;
  let high = ranked.length;
  while (low < high) {
    const mid = Math.ceil((low + high) / 2);
    if (estimateTokens(build(mid)) <= target) low = mid;
    else high = mid - 1;
  }
  return build(low);
}

function writeMap(root, markdown) {
  const dir = join(root, "lat.md");
  mkdirSync(dir, { recursive: true });
  writeFileSync(join(dir, "repo-map.md"), markdown);
  const index = join(dir, "lat.md");
  if (!existsSync(index)) {
    writeFileSync(index, `# ${basename(root)}\n\nKnowledge graph of ${basename(root)}.\n\n${INDEX_LINE}\n`);
    return;
  }
  const lines = readFileSync(index, "utf8").split("\n");
  const at = lines.findIndex((line) => line.startsWith("- [[repo-map]]"));
  if (at >= 0) {
    if (lines[at] === LEGACY_INDEX_LINE) lines[at] = INDEX_LINE;
  } else lines.splice(lines.at(-1) === "" ? lines.length - 1 : lines.length, 0, INDEX_LINE);
  const next = lines.join("\n");
  writeFileSync(index, next.endsWith("\n") ? next : `${next}\n`);
}

function resolveFocus(root, focus, known) {
  const found = [];
  for (const file of focus) {
    const path = [process.cwd(), root].map((base) => relative(root, resolve(base, file))).find((candidate) => known.has(candidate));
    if (path) found.push(path);
  }
  return found;
}

const opts = parseArgs(process.argv.slice(2));
const root = resolveRoot(opts.root);
const sources = readSources(root);
opts.focus = resolveFocus(root, opts.focus, new Set(sources.map((source) => source.path)));
const files = rankFiles(await extractDefs(sources), opts);

if (opts.json) {
  const data = files.map((file) => ({
    path: file.path,
    rank: file.fileRank,
    defs: file.defs.map(({ name, kind, parent, startLine, endLine, signature, rank }) => ({ name, kind, parent, startLine, endLine, signature, rank })),
  }));
  process.stdout.write(`${JSON.stringify({ root, budget: opts.budget, files: data }, null, 2)}\n`);
} else if (opts.write) writeMap(root, renderFull(files));
else process.stdout.write(fit(files, opts.budget));
