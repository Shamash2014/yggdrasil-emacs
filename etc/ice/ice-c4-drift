#!/usr/bin/env python3
import glob
import json
import os
import re
import subprocess
import sys
import tempfile


def git_root(path):
    out = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else None


def default_arch(root):
    for candidate in ("docs/arch", "doc/arch"):
        if os.path.isfile(os.path.join(root, candidate, "likec4.config.json")):
            return os.path.join(root, candidate)
    return None


def code_line(arch, root, path):
    pattern = re.compile(r"\bcode\s+['\"]" + re.escape(path) + r"['\"]")
    for source in sorted(glob.glob(os.path.join(arch, "**", "*.c4"), recursive=True)):
        with open(source, encoding="utf-8") as f:
            for n, line in enumerate(f, 1):
                if pattern.search(line):
                    return "%s:%d: " % (os.path.relpath(source, root), n)
    return ""


def main(argv):
    root = git_root(argv[1] if len(argv) > 1 else ".")
    if not root:
        sys.stderr.write("ice-c4-drift: not inside a git repository\n")
        return 2
    arch = os.path.abspath(argv[1]) if len(argv) > 1 else default_arch(root)
    config = os.path.join(arch or "", "likec4.config.json")
    if not arch or not os.path.isfile(config):
        sys.stderr.write("ice-c4-drift: no likec4.config.json under docs/arch or doc/arch\n")
        return 2
    with open(config, encoding="utf-8") as f:
        project = json.load(f).get("name")
    with tempfile.TemporaryDirectory() as tmp:
        out = os.path.join(tmp, "model.json")
        run = subprocess.run(["likec4", "export", "json", "--skip-layout", "-o", out, arch],
                             capture_output=True, text=True)
        if run.returncode != 0 or not os.path.isfile(out):
            sys.stderr.write(run.stdout + run.stderr + "ice-c4-drift: likec4 export json failed\n")
            return 2
        with open(out, encoding="utf-8") as f:
            exported = json.load(f)
    entries = exported if isinstance(exported, list) else [exported]
    model = next((e for e in entries if e.get("projectId") == project), None)
    if model is None:
        sys.stderr.write("ice-c4-drift: export has no project %r\n" % project)
        return 2
    checked, gone = 0, []
    for element_id, element in sorted(model.get("elements", {}).items()):
        code = (element.get("metadata") or {}).get("code")
        if not code:
            continue
        paths = code if isinstance(code, list) else [code]
        for path in paths:
            checked += 1
            if not os.path.exists(os.path.join(root, path)):
                gone.append("%s%s: code path %s no longer exists" % (code_line(arch, root, path), element_id, path))
    for line in gone:
        print(line)
    if not gone:
        print("ice-c4-drift: ok, %d code path(s) present" % checked)
    return 1 if gone else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
