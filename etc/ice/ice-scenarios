#!/usr/bin/env python3
import ast
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

HELP = """usage: ice-scenarios CHANGE [--tests]

Print the scenario ids of a change's expectations.md, one per line.
CHANGE is a change name under openspec/changes or a path to its folder.
--tests adds, after a tab, each test that names the scenario, as FILE::NAME.

A test names a scenario when its own name, title, decorator, docstring
or body holds the id (cart#promo-before-tax) or its slug
(cart__promo_before_tax); an id at module level or in a helper that is
not a test counts for nothing. A change name is letters, digits, dot,
underscore and dash only. The other ice tools load this file for the
shared parts."""

SCENARIO_HEADING = re.compile(r"^##\s+Scenario:\s*(\S+)")
CONFIG_KEYS = ("test_cmd", "report_path", "lock_paths", "sec_cmd", "live_cmd", "perf_cmd", "mutate_cmd", "commit_gate")
LEDGER_COLUMNS = ("ts", "change", "branch", "sha", "verdict", "evidence", "hash")
ICE_BOOKKEEPING = (".ice/state", ".ice/evidence", ".ice/ledger.tsv")
TEST_FILE = re.compile(r"(^|/)(test_[^/]*\.py|[^/]*_test\.py|[^/]*_test\.go|[^/]*[._-](test|spec)s?\.[cm]?[jt]sx?|[^/]*-tests?\.el|[^/]*_spec\.rb|[^/]*Tests?\.(swift|kt|java))$")
TEST_SUPPORT = re.compile(r"(^|/)(conftest\.py|__snapshots__/|__fixtures__/|fixtures/|testdata/|test-data/|test_helper[^/]*|test-helper[^/]*)")
CHANGE_NAME = re.compile(r"^[A-Za-z0-9._-]+$")
SUPPORT_NAMES = ("conftest.py", "pyproject.toml", "pytest.ini", "setup.cfg", "tox.ini", "package.json")
SUPPORT_CONFIG = re.compile(r"^(jest|vitest|vite)\.config\.[A-Za-z0-9.]+$")
RECORD_BEGIN = "-----BEGIN ICE LOCK RECORD-----"
RECORD_END = "-----END ICE LOCK RECORD-----"
CLOSING_LINE = re.compile(r"^\s*[\]\)}]")
TEST_DEF = [
    re.compile(r"^\s*(?:async\s+)?def\s+(test\w*)"),
    re.compile(r"^\s*(?:it|test|describe)(?:\.\w+)?\s*\(\s*(['\"`])(.+?)\1"),
    re.compile(r"^\s*\(ert-deftest\s+([^\s()]+)"),
    re.compile(r"^\s*func\s+(Test\w+)"),
    re.compile(r"^\s*(?:it|scenario|specify)\s+(['\"])(.+?)\1"),
    re.compile(r"^\s*(?:@Test\s+)?(?:public\s+)?(?:func|fun|void)\s+(test\w*)"),
]


def die(message, code=2):
    print(message, file=sys.stderr)
    sys.exit(code)


def git(*args, cwd=None, check=True):
    out = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and out.returncode != 0:
        die("git %s: %s" % (" ".join(args), out.stderr.strip()))
    return out.stdout.strip()


def repo_root():
    return git("rev-parse", "--show-toplevel")


def ledger_path(root):
    return os.path.join(root, ".ice", "ledger.tsv")


def read_ledger(root):
    path = ledger_path(root)
    if not os.path.isfile(path):
        return []
    with open(path, encoding="utf-8") as f:
        rows = [line.rstrip("\n").split("\t") for line in f if line.strip()]
    return [dict(zip(LEDGER_COLUMNS, row)) for row in rows if row and row[0] != "ts"]


def append_ledger(root, row):
    path = ledger_path(root)
    fresh = not os.path.isfile(path)
    with open(path, "a", encoding="utf-8") as f:
        if fresh:
            f.write("\t".join(LEDGER_COLUMNS) + "\n")
        f.write("\t".join(row.get(c, "") for c in LEDGER_COLUMNS) + "\n")


def _write_tree_excluding_bookkeeping(root, index_file):
    env = dict(os.environ, GIT_INDEX_FILE=index_file)
    subprocess.run(["git", "rm", "--cached", "-r", "-q", "--ignore-unmatch", *ICE_BOOKKEEPING],
                   cwd=root, env=env, capture_output=True, text=True)
    out = subprocess.run(["git", "write-tree"], cwd=root, env=env, capture_output=True, text=True)
    if out.returncode != 0:
        die("ice: git write-tree failed: %s" % out.stderr.strip())
    return out.stdout.strip()


def _real_index_path(root, given=None):
    path = given or os.environ.get("GIT_INDEX_FILE")
    if path:
        return path
    return git("rev-parse", "--path-format=absolute", "--git-path", "index", cwd=root)


def working_tree_hash(root):
    """Tree hash of the working tree (tracked and untracked, respecting
    .gitignore) minus the ice bookkeeping paths: the content ice-verify
    actually tested, independent of HEAD or the index."""
    real_index = _real_index_path(root)
    fd, tmp = tempfile.mkstemp(prefix="ice-index-")
    os.close(fd)
    try:
        if os.path.isfile(real_index):
            shutil.copyfile(real_index, tmp)
        env = dict(os.environ, GIT_INDEX_FILE=tmp)
        out = subprocess.run(["git", "add", "-A"], cwd=root, env=env, capture_output=True, text=True)
        if out.returncode != 0:
            die("ice: git add -A into a temp index failed: %s" % out.stderr.strip())
        return _write_tree_excluding_bookkeeping(root, tmp)
    finally:
        os.unlink(tmp)


def staged_tree_hash(root):
    """Tree hash of the index git is about to commit (GIT_INDEX_FILE when
    a hook is given one, else the repo's own index) minus the ice
    bookkeeping paths: the content a commit is about to record."""
    real_index = _real_index_path(root)
    fd, tmp = tempfile.mkstemp(prefix="ice-index-")
    os.close(fd)
    try:
        if os.path.isfile(real_index):
            shutil.copyfile(real_index, tmp)
        return _write_tree_excluding_bookkeeping(root, tmp)
    finally:
        os.unlink(tmp)


def default_branch(root):
    ref = git("symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD", cwd=root, check=False)
    if ref:
        return ref
    for name in (git("config", "init.defaultBranch", cwd=root, check=False), "main", "master"):
        if name and git("rev-parse", "-q", "--verify", name + "^{commit}", cwd=root, check=False):
            return name
    die("ice: no default branch found; pass --base")


def check_name(name):
    if not CHANGE_NAME.match(name or "") or not name.strip("."):
        die("ice: refused change name %r: use letters, digits, dot, underscore and dash only" % name)
    return name


def change_dir(root, change):
    check_name(os.path.basename(change.rstrip("/")))
    for path in (change, os.path.join(root, change), os.path.join(root, "openspec", "changes", change)):
        if os.path.isfile(os.path.join(path, "expectations.md")):
            check_name(os.path.basename(os.path.realpath(path)))
            return os.path.realpath(path)
    die("ice: no expectations.md for change %s (looked under openspec/changes)" % change)


def change_name(path):
    return os.path.basename(path.rstrip("/"))


def scenario_ids(change_path):
    with open(os.path.join(change_path, "expectations.md"), encoding="utf-8") as f:
        return [m.group(1) for m in map(SCENARIO_HEADING.match, f) if m]


def slug(scenario_id):
    return re.sub(r"[^A-Za-z0-9_]", "_", scenario_id.replace("#", "__"))


def names_scenario(text, scenario_id):
    by_id = r"(?<![\w#./-])%s(?![\w-])" % re.escape(scenario_id)
    by_slug = r"(?<![A-Za-z0-9])%s(?![A-Za-z0-9]|_(?!_))" % re.escape(slug(scenario_id))
    return bool(re.search(by_id, text) or re.search(by_slug, text))


def read_config(root):
    config, path = {}, os.path.join(root, ".ice", "config")
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = (part.strip() for part in line.split("=", 1))
                if key in CONFIG_KEYS and value:
                    config[key] = value
    return config


def tracked_files(root):
    listed = git("ls-files", "--cached", "--others", "--exclude-standard", "-z", cwd=root)
    return sorted({p for p in listed.split("\0") if p and os.path.isfile(os.path.join(root, p))})


def test_files(root):
    return [p for p in tracked_files(root) if TEST_FILE.search(p) and not p.startswith((".ice/", "openspec/"))]


def is_test_or_support(rel):
    return bool(TEST_FILE.search(rel) or TEST_SUPPORT.search(rel))


def in_folder(rel, folder):
    return os.path.dirname(rel) == folder or (folder != "" and rel.startswith(folder + "/"))


def test_name(line):
    for pattern in TEST_DEF:
        m = pattern.match(line)
        if m:
            return m.group(m.lastindex)
    return None


def python_tests(text):
    tree, lines, out = ast.parse(text), text.splitlines(), []

    def add(node, prefix):
        start = min([d.lineno for d in node.decorator_list] + [node.lineno])
        out.append((prefix + node.name, "\n".join(lines[start - 1:node.end_lineno])))

    functions = (ast.FunctionDef, ast.AsyncFunctionDef)
    for node in tree.body:
        if isinstance(node, functions) and node.name.startswith("test"):
            add(node, "")
        elif isinstance(node, ast.ClassDef):
            for sub in node.body:
                if isinstance(sub, functions) and sub.name.startswith("test"):
                    add(sub, node.name + "::")
    return out


def indent_of(line):
    return len(line) - len(line.lstrip())


def block_tests(text):
    lines, blocks = text.splitlines(), []
    for i, line in enumerate(lines):
        name = test_name(line)
        if not name:
            continue
        start, base, end = i, indent_of(line), i + 1
        while start > 0 and lines[start - 1].strip().startswith("@") and indent_of(lines[start - 1]) == base:
            start -= 1
        while end < len(lines) and (not lines[end].strip() or indent_of(lines[end]) > base):
            end += 1
        if end < len(lines) and indent_of(lines[end]) == base and CLOSING_LINE.match(lines[end]):
            end += 1
        blocks.append((name, i, start, end))
    out = []
    for name, i, start, end in blocks:
        nested = {n for _, j, s, e in blocks if i < j < end for n in range(s, e)}
        out.append((name, "\n".join(l for n, l in enumerate(lines[start:end], start) if n not in nested)))
    return out


def tests_in(rel, text):
    if rel.endswith(".py"):
        try:
            return python_tests(text)
        except SyntaxError:
            pass
    return block_tests(text)


def find_tests(root, ids):
    found = {sid: [] for sid in ids}
    for rel in test_files(root):
        try:
            with open(os.path.join(root, rel), encoding="utf-8") as f:
                text = f.read()
        except (UnicodeDecodeError, OSError):
            continue
        for name, body in tests_in(rel, text):
            for sid in ids:
                if names_scenario(body, sid) and (rel, name) not in found[sid]:
                    found[sid].append((rel, name))
    return found


def support_dirs(test_dirs):
    dirs = {""}
    for folder in test_dirs:
        parts = [p for p in folder.split("/") if p]
        dirs.update("/".join(parts[:n]) for n in range(1, len(parts) + 1))
    return sorted(dirs)


def support_files(root, dirs):
    found = set()
    for folder in dirs:
        full = os.path.join(root, folder)
        if not os.path.isdir(full):
            continue
        for entry in os.listdir(full):
            if (entry in SUPPORT_NAMES or SUPPORT_CONFIG.match(entry)) and os.path.isfile(os.path.join(full, entry)):
                found.add(os.path.join(folder, entry) if folder else entry)
    return found


def ice_scripts(root):
    folder = os.path.join(root, ".ice")
    if not os.path.isdir(folder):
        return set()
    return {".ice/" + e for e in os.listdir(folder) if e.startswith("ice-") and os.path.isfile(os.path.join(folder, e))}


def tag_name(name):
    return "ice-expect/" + name


def tag_record(root, name):
    ref = "refs/tags/" + tag_name(name)
    if not git("rev-parse", "-q", "--verify", ref, cwd=root, check=False):
        return None, None
    raw = git("cat-file", "-p", ref, cwd=root)
    signed = bool(re.search(r"^-----BEGIN (PGP|SSH) SIGNATURE-----", raw, re.M))
    lines = raw.split("\n")
    if RECORD_BEGIN not in lines or RECORD_END not in lines[lines.index(RECORD_BEGIN):]:
        return {}, signed
    begin = lines.index(RECORD_BEGIN)
    end = lines.index(RECORD_END, begin)
    try:
        return json.loads("\n".join(lines[begin + 1:end])), signed
    except ValueError:
        return {}, signed


def fill(template, values):
    # a token whose placeholders all come out empty is dropped, so one template serves one test and the whole suite
    tokens = []
    for token in shlex.split(template):
        keys = re.findall(r"\{(\w+)\}", token)
        if keys and all(not values.get(k) for k in keys):
            continue
        tokens.append(re.sub(r"\{(\w+)\}", lambda m: values.get(m.group(1), ""), token))
    return tokens


def main(argv):
    args = [a for a in argv[1:] if not a.startswith("-")]
    if "-h" in argv or "--help" in argv:
        print(HELP)
        return 0
    if len(args) != 1:
        die(HELP)
    root = repo_root()
    ids = scenario_ids(change_dir(root, args[0]))
    tests = find_tests(root, ids) if "--tests" in argv else {}
    for sid in ids:
        if "--tests" in argv:
            print("\t".join([sid] + (["%s::%s" % t for t in tests[sid]] or ["(no test)"])))
        else:
            print(sid)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
