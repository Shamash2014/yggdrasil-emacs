#!/usr/bin/env python3
import argparse
import datetime
import importlib.machinery
import importlib.util
import io
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile

sys.dont_write_bytecode = True
_loader = importlib.machinery.SourceFileLoader("ice_scenarios", os.path.join(os.path.dirname(os.path.realpath(__file__)), "ice-scenarios"))
ice = importlib.util.module_from_spec(importlib.util.spec_from_loader("ice_scenarios", _loader))
_loader.exec_module(ice)

DESCRIPTION = """Each scenario's check must fail on the base commit and pass on HEAD.

The base tree is copied with git archive into a temporary folder and the
test files and test support (conftest.py, fixtures, snapshots) in the
scenario tests' folders are laid over it from the working tree, never
source beside them; the working
tree itself is never checked out, stashed or changed. HEAD runs in the
working tree. Tests run one at a time through test_cmd in .ice/config, or
--test-cmd, with {file} and {filter} filled per test (e.g.
python3 -m pytest -q {file}::{filter}); keep each placeholder inside one
token with its flag (--testNamePattern={filter}), since the whole-suite
run drops a token whose placeholders are empty. A test that errors on
base, say on an import the change adds, counts as failing there. The
result goes to
.ice/state/CHANGE.json. Exit 0 when every scenario passes the gate, 1 when
any does not, 2 when it cannot run."""

LINKED_DIRS = ("node_modules", ".venv", "venv")


def export_tree(root, rev, dest):
    archive = subprocess.run(["git", "archive", "--format=tar", rev], cwd=root, capture_output=True)
    if archive.returncode != 0:
        ice.die("ice-fail-on-base: git archive %s: %s" % (rev, archive.stderr.decode().strip()))
    with tarfile.open(fileobj=io.BytesIO(archive.stdout)) as tar:
        tar.extractall(dest, filter="data") if hasattr(tarfile, "data_filter") else tar.extractall(dest)
    for name in LINKED_DIRS:
        if os.path.isdir(os.path.join(root, name)) and not os.path.exists(os.path.join(dest, name)):
            os.symlink(os.path.join(root, name), os.path.join(dest, name))


def run_test(template, cwd, rel, name):
    argv = ice.fill(template, {"file": rel, "filter": name})
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
    out = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, env=env)
    return out.returncode, (out.stdout + out.stderr).strip().splitlines()[-3:]


def main():
    parser = argparse.ArgumentParser(prog="ice-fail-on-base", description=DESCRIPTION,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("change")
    parser.add_argument("--base", help="base commit (default: merge-base of HEAD with the default branch)")
    parser.add_argument("--test-cmd", help="overrides test_cmd from .ice/config")
    parser.add_argument("--for", dest="only", metavar="SCENARIO_ID", help="gate this scenario only")
    args = parser.parse_args()

    root = ice.repo_root()
    change = ice.change_dir(root, args.change)
    name = ice.change_name(change)
    template = args.test_cmd or ice.read_config(root).get("test_cmd")
    if not template or "{filter}" not in template:
        ice.die("ice-fail-on-base: no test_cmd with {filter} in .ice/config and no --test-cmd")
    head = ice.git("rev-parse", "HEAD", cwd=root)
    base = ice.git("rev-parse", args.base or ice.git("merge-base", "HEAD", ice.default_branch(root), cwd=root), cwd=root)
    if base == head:
        ice.die("ice-fail-on-base: base is HEAD (%s); run it on the change's branch or pass --base" % head[:12])

    ids = ice.scenario_ids(change)
    if args.only:
        if args.only not in ids:
            ice.die("ice-fail-on-base: %s is not a scenario of %s" % (args.only, name))
        ids = [args.only]
    tests = ice.find_tests(root, ids)
    dirty = bool(ice.git("status", "--porcelain", "--untracked-files=no", cwd=root))

    results, failed = {}, False
    with tempfile.TemporaryDirectory(prefix="ice-base.") as tmp:
        export_tree(root, base, tmp)
        folders = {os.path.dirname(rel) for found in tests.values() for rel, _ in found}
        for rel in ice.tracked_files(root):
            if ice.is_test_or_support(rel) and any(ice.in_folder(rel, f) for f in folders):
                os.makedirs(os.path.dirname(os.path.join(tmp, rel)), exist_ok=True)
                shutil.copyfile(os.path.join(root, rel), os.path.join(tmp, rel))
        for sid in ids:
            if not tests[sid]:
                results[sid] = {"ok": False, "reason": "no test names this scenario", "tests": []}
                print("MISSING %s: no test names it (id or %s)" % (sid, ice.slug(sid)))
                failed = True
                continue
            runs = []
            for rel, test in tests[sid]:
                base_code, base_tail = run_test(template, tmp, rel, test)
                head_code, head_tail = run_test(template, root, rel, test)
                runs.append({"test": "%s::%s" % (rel, test), "base_exit": base_code, "head_exit": head_code,
                             "base_tail": base_tail, "head_tail": head_tail})
            bad_base = [r["test"] for r in runs if r["base_exit"] == 0]
            bad_head = [r["test"] for r in runs if r["head_exit"] != 0]
            ok = not bad_base and not bad_head
            failed |= not ok
            reason = "; ".join(filter(None, ["passes on base: " + ", ".join(bad_base) if bad_base else "",
                                             "fails on HEAD: " + ", ".join(bad_head) if bad_head else ""]))
            results[sid] = {"ok": ok, "reason": reason, "tests": runs}
            if ok:
                print("ok %s: %s fails on base %s, passes on HEAD %s" % (sid, ", ".join(r["test"] for r in runs), base[:7], head[:7]))
            else:
                print("REJECT %s: %s" % (sid, reason))

    state_dir = os.path.join(root, ".ice", "state")
    os.makedirs(state_dir, exist_ok=True)
    state_path = os.path.join(state_dir, name + ".json")
    state = {}
    if args.only and os.path.isfile(state_path):
        with open(state_path, encoding="utf-8") as f:
            state = json.load(f)
        if state.get("head") != head or state.get("base") != base:
            state = {}
    state.update({"change": name, "base": base, "head": head, "dirty": dirty,
                  "ts": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
                  "test_cmd": template})
    state.setdefault("scenarios", {}).update(results)
    state["ok"] = all(s["ok"] for s in state["scenarios"].values())
    with open(state_path, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)
        f.write("\n")
    print("fail-on-base %s: %s (base %s, head %s%s) -> %s" % (
        name, "pass" if not failed else "fail", base[:7], head[:7], ", tree dirty" if dirty else "",
        os.path.relpath(state_path, root)))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
