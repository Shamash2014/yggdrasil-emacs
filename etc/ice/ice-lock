#!/usr/bin/env python3
import argparse
import datetime
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys

sys.dont_write_bytecode = True
_loader = importlib.machinery.SourceFileLoader("ice_scenarios", os.path.join(os.path.dirname(os.path.realpath(__file__)), "ice-scenarios"))
ice = importlib.util.module_from_spec(importlib.util.spec_from_loader("ice_scenarios", _loader))
_loader.exec_module(ice)

DESCRIPTION = """Lock a change's checks, or verify they are unchanged since the lock.

lock records the locked set: the change's expectations.md and spec deltas,
the test files that name a scenario id, .ice/config, the paths in
lock_paths (.ice/config, space or comma separated, files or folders), and
the test scripts of package.json. It writes their sha256 and HEAD to
.ice/locks/CHANGE.json and the same record into the annotated tag
ice-expect/CHANGE, signed when git config user.signingkey is set. A lock
that differs from the tag needs --force, which moves the tag.

verify compares the working tree with the record in the tag, and exits 1
naming every locked path that changed or went missing, every new file in
the spec deltas or a lock_paths folder, and every new test or test
support file (conftest.py, fixtures, snapshots) beside a locked test;
source beside a test stays free. Exit 2 when the change is not locked."""

SIGNATURE = re.compile(r"^-----BEGIN (PGP|SSH) SIGNATURE-----", re.M)


def sha256(path):
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def package_test_scripts(root):
    path = os.path.join(root, "package.json")
    if not os.path.isfile(path):
        return None
    with open(path, encoding="utf-8") as f:
        scripts = json.load(f).get("scripts", {})
    tests = {k: v for k, v in sorted(scripts.items()) if "test" in k}
    return tests or None


def locked_set(root, change):
    rel_change = os.path.relpath(change, root)
    listed = ice.tracked_files(root)
    files, dirs, test_dirs = {os.path.join(rel_change, "expectations.md"), ".ice/config"}, set(), set()
    specs = os.path.join(rel_change, "specs")
    if os.path.isdir(os.path.join(root, specs)):
        dirs.add(specs)
    for found in ice.find_tests(root, ice.scenario_ids(change)).values():
        for rel, _ in found:
            files.add(rel)
            test_dirs.add(os.path.dirname(rel))
    for entry in re.split(r"[,\s]+", ice.read_config(root).get("lock_paths", "")):
        entry = entry.strip("/")
        if not entry:
            continue
        if os.path.isdir(os.path.join(root, entry)):
            dirs.add(entry)
        elif os.path.isfile(os.path.join(root, entry)):
            files.add(entry)
        else:
            ice.die("ice-lock: lock_paths names %s, which does not exist" % entry)
    inside = {d: sorted(p for p in listed if p.startswith(d + "/")) for d in sorted(dirs)}
    tests_inside = {d: sorted(p for p in listed if ice.is_test_or_support(p) and ice.in_folder(p, d)) for d in sorted(test_dirs)}
    for members in list(inside.values()) + list(tests_inside.values()):
        files.update(members)
    files = {f for f in files if os.path.isfile(os.path.join(root, f))}
    return {"files": {f: sha256(os.path.join(root, f)) for f in sorted(files)},
            "dirs": inside,
            "test_dirs": tests_inside,
            "package_test_scripts": package_test_scripts(root)}


def tag_name(name):
    return "ice-expect/" + name


def tag_record(root, name):
    ref = "refs/tags/" + tag_name(name)
    if not ice.git("rev-parse", "-q", "--verify", ref, cwd=root, check=False):
        return None, None
    raw = ice.git("cat-file", "-p", ref, cwd=root)
    message = raw.split("\n\n", 1)[1] if "\n\n" in raw else ""
    signed = bool(SIGNATURE.search(message))
    body = SIGNATURE.split(message)[0]
    start = body.find("{")
    return (json.loads(body[start:]) if start >= 0 else None), signed


def comparable(record):
    return {k: record.get(k) for k in ("files", "dirs", "test_dirs", "package_test_scripts")}


def lock(root, change, name, force):
    record = locked_set(root, change)
    record.update({"change": name, "head": ice.git("rev-parse", "HEAD", cwd=root),
                   "ts": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")})
    existing, signed = tag_record(root, name)
    lock_path = os.path.join(root, ".ice", "locks", name + ".json")
    if existing is not None and comparable(existing) == comparable(record):
        print("ice-lock %s: already locked, nothing changed (%d paths, tag %s, %s)"
              % (name, len(record["files"]), tag_name(name), "signed" if signed else "unsigned"))
        if not os.path.isfile(lock_path):
            write_json(lock_path, existing)
        return 0
    if existing is not None and not force:
        print("ice-lock %s: the locked set differs from tag %s; the owner re-locks with --force" % (name, tag_name(name)))
        for line in differences(root, existing):
            print("  " + line)
        return 1
    write_json(lock_path, record)
    signing = bool(ice.git("config", "user.signingkey", cwd=root, check=False))
    message = "ice-expect %s\n\n%s\n" % (name, json.dumps(record, indent=2, sort_keys=True))
    argv = ["git", "tag", "-s" if signing else "-a", "--cleanup=verbatim", "-F", "-"] + (["-f"] if force else []) + [tag_name(name), "HEAD"]
    out = subprocess.run(argv, cwd=root, input=message, capture_output=True, text=True)
    if out.returncode != 0:
        ice.die("ice-lock: git tag failed: %s" % out.stderr.strip())
    print("ice-lock %s: locked %d paths at %s -> %s, tag %s (%s)" % (
        name, len(record["files"]), record["head"][:7], os.path.relpath(lock_path, root), tag_name(name),
        "signed with user.signingkey" if signing else "unsigned annotated: no user.signingkey"))
    for path in record["files"]:
        print("  " + path)
    if record["package_test_scripts"]:
        print("  package.json scripts: " + ", ".join(record["package_test_scripts"]))
    return 0


def write_json(path, record):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(record, f, indent=2, sort_keys=True)
        f.write("\n")


def differences(root, record):
    lines = []
    for path, digest in sorted(record["files"].items()):
        full = os.path.join(root, path)
        if not os.path.isfile(full):
            lines.append("missing: " + path)
        elif sha256(full) != digest:
            lines.append("changed: " + path)
    listed = ice.tracked_files(root)
    for folder, members in sorted(record["dirs"].items()):
        for path in listed:
            if path.startswith(folder + "/") and path not in members:
                lines.append("new: %s (in locked folder %s)" % (path, folder))
    for folder, members in sorted(record.get("test_dirs", {}).items()):
        for path in listed:
            if ice.is_test_or_support(path) and ice.in_folder(path, folder) and path not in members:
                lines.append("new: %s (test file in locked folder %s)" % (path, folder or "."))
    if package_test_scripts(root) != record.get("package_test_scripts"):
        lines.append("changed: package.json test scripts")
    return lines


def verify(root, name):
    record, signed = tag_record(root, name)
    if record is None:
        print("ice-lock %s: not locked (no tag %s)" % (name, tag_name(name)))
        return 2
    problems = differences(root, record)
    lock_path = os.path.join(root, ".ice", "locks", name + ".json")
    if os.path.isfile(lock_path):
        with open(lock_path, encoding="utf-8") as f:
            if comparable(json.load(f)) != comparable(record):
                problems.append("changed: %s differs from tag %s" % (os.path.relpath(lock_path, root), tag_name(name)))
    if signed:
        check = subprocess.run(["git", "tag", "-v", tag_name(name)], cwd=root, capture_output=True, text=True)
        if check.returncode != 0:
            problems.append("signature: tag %s does not verify" % tag_name(name))
    kind = "signed" if signed else "unsigned"
    if problems:
        print("ice-lock %s: FAILED against tag %s (%s, locked at %s)" % (name, tag_name(name), kind, record["head"][:7]))
        for line in problems:
            print("  " + line)
        return 1
    print("ice-lock %s: clean, %d paths match tag %s (%s, locked at %s)" % (
        name, len(record["files"]), tag_name(name), kind, record["head"][:7]))
    return 0


def main():
    parser = argparse.ArgumentParser(prog="ice-lock", description=DESCRIPTION,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("change")
    parser.add_argument("action", choices=("lock", "verify"))
    parser.add_argument("--force", action="store_true", help="re-lock a changed set and move the tag")
    args = parser.parse_args()
    root = ice.repo_root()
    change = ice.change_dir(root, args.change)
    name = ice.change_name(change)
    if args.action == "lock":
        return lock(root, change, name, args.force)
    return verify(root, name)


if __name__ == "__main__":
    sys.exit(main())
