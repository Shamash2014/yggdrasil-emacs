  (ygg-agent-maps-tests--with '("features.md")
    (let ((s (ygg-agent-maps-tests--session root :agent "claude" :acp-id "sess-1")))
      (ygg-agent-maps-tests--sent-once s)
      (should (aob-session-ref s :maps-sent))
      (cl-letf (((symbol-function 'aob-acp--request)
                 (lambda (_s _m _p cb) (funcall cb '(:stopReason "end_turn") nil))))
        (aob-acp--prompt s "/clear"))
      (should (eq (aob-session-ref s :maps-pending) t))
      (should-not (aob-session-ref s :maps-sent))
      (should (string-match-p "MAP-BODY" (ygg-agent-maps-tests--first-block s)))
      (ygg-agent-maps-tests--sent-once-more s)
      (aob-remove-session s))))

(ert-deftest ygg-agent-maps-pi-clear-sends-the-maps-again ()
  (ygg-agent-maps-tests--with '("features.md")
    (let* ((proc (make-process :name "maps-cat" :command '("cat")
                               :connection-type 'pipe :noquery t))
           (s (ygg-agent-maps-tests--session root :agent "pi")))
      (unwind-protect
          (progn
            (process-put proc 'aob-sessions (make-hash-table :test #'equal))
            (process-put proc 'aob-init '(done (:agentCapabilities nil)))
            (setf (aob-session-conn s) proc)
            (ygg-agent-maps-tests--sent-once s)
            (cl-letf (((symbol-function 'aob-acp--request)
                       (lambda (_s _m _p cb) (funcall cb '(:sessionId "fresh") nil))))
              (aob-acp-clear s))
            (should (eq (aob-session-ref s :maps-pending) t))
            (should-not (aob-session-ref s :maps-sent))
            (should (string-match-p "MAP-BODY" (ygg-agent-maps-tests--first-block s)))
            (ygg-agent-maps-tests--sent-once-more s))
        (delete-process proc)
        (aob-remove-session s)))))

