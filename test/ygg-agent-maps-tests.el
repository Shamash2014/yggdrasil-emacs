(ert-deftest ygg-agent-maps-dirty-paths-with-spaces-and-renames-are-statted ()
  (ygg-agent-maps-tests--with '("features.md")
    (let ((file (expand-file-name "sp ace.txt" root)))
      (with-temp-file file (insert "a\n"))
      (setq ygg-agent-maps-tests--dirty
            "1 .M N... 100644 100644 100644 a b sp ace.txt\0")
      (set-file-times file (seconds-to-time 1000))
      (ygg-agent-maps-refresh root)
      (should (= 1 (ygg-agent-maps-tests--calls-of "ice-repo-map")))
      (set-file-times file (seconds-to-time 2000))
      (ygg-agent-maps-refresh root)
      (should (= 2 (ygg-agent-maps-tests--calls-of "ice-repo-map")))
      (let ((statted nil))
        (cl-letf (((symbol-function 'ygg-agent-maps--mtime)
                   (lambda (f) (push (file-name-nondirectory f) statted) 1.0)))
          (setq ygg-agent-maps-tests--dirty
                "2 R. N... 100644 100644 100644 a b R100 new name.txt\0old name.txt\0u UU N... 1 2 3 4 a b c merged f.txt\0")
          (ygg-agent-maps--state root (concat "# branch.oid a\0" ygg-agent-maps-tests--dirty)))
        (should (equal '("merged f.txt" "new name.txt") (sort statted #'string<)))))))

(ert-deftest ygg-agent-maps-dirty-stat-work-is-capped ()
  (ygg-agent-maps-tests--with nil
    (let* ((n (* 3 ygg-agent-maps--stat-cap))
           (records (cl-loop for i below n
                             concat (format "1 .M N... 100644 100644 100644 a b f%d\0" i)))
           (statted 0))
      (cl-letf (((symbol-function 'ygg-agent-maps--mtime)
                 (lambda (_f) (cl-incf statted) 1.0)))
        (let ((a (ygg-agent-maps--state root (concat "# branch.oid a\0" records)))
              (b (ygg-agent-maps--state root (concat "# branch.oid a\0" records
                                                      "1 .M N... 100644 100644 100644 a b extra\0"))))
          (should (= statted (* 2 ygg-agent-maps--stat-cap)))
          (should-not (equal (cadr a) (cadr b))))))))

