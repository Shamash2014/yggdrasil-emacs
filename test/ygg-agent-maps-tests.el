(ert-deftest ygg-agent-maps-remote-project-touches-no-file ()
  (ygg-agent-maps-tests--with '("features.md")
    (let* ((remote "/ssh:nowhere:/srv/proj/")
           (s (ygg-agent-maps-tests--session remote))
           (touched nil))
      (cl-letf (((symbol-function 'file-directory-p)
                 (lambda (&rest _) (push 'dir touched) nil))
                ((symbol-function 'file-readable-p)
                 (lambda (&rest _) (push 'readable touched) nil))
                ((symbol-function 'file-executable-p)
                 (lambda (&rest _) (push 'exec touched) nil))
                ((symbol-function 'file-attributes)
                 (lambda (&rest _) (push 'attrs touched) nil)))
        (ygg-agent-maps-on-ready s)
        (ygg-agent-maps-refresh remote)
        (ygg-agent-maps-warm s)
        (aob-session-put s :maps-pending t)
        (should-not (plist-get (ygg-agent-maps--place (lambda (_s) nil) s) :text))
        (should-not touched)
        (should-not ygg-agent-maps-tests--calls))
      (aob-remove-session s))))

(ert-deftest ygg-agent-maps-nested-waits-share-one-deadline ()
  (let* ((tools (file-name-as-directory (make-temp-file "ygg-maps-nest-tools-" t)))
         (roots (list (file-name-as-directory (file-truename (make-temp-file "ygg-maps-n1-" t)))
                      (file-name-as-directory (file-truename (make-temp-file "ygg-maps-n2-" t)))))
         (ygg-agent-maps-tools-dir tools)
         (ygg-agent-maps-interpreter nil)
         (ygg-agent-maps-wait 0.3)
         (ygg-agent-maps--cache (make-hash-table :test #'equal))
         (sessions nil)
         (timer nil))
    (unwind-protect
        (progn
          (dolist (tool '("ice-repo-map"))
            (let ((f (expand-file-name tool tools)))
              (with-temp-file f (insert "#!/bin/sh\nsleep 5\n"))
              (set-file-modes f #o755)))
          (dolist (r roots)
            (let ((default-directory r))
              (call-process "git" nil nil nil "init" "-q")
              (call-process "git" nil nil nil "-c" "user.name=t" "-c" "user.email=t@t"
                            "commit" "-q" "--allow-empty" "-m" "i"))
            (let ((s (ygg-agent-maps-tests--session r)))
              (push s sessions)
              (aob-session-put s :maps-pending t)))
          (let ((start (float-time)))
            (setq timer (run-at-time 0.1 nil
                                     (lambda ()
                                       (ygg-agent-maps--place (lambda (_s) nil) (cadr sessions)))))
            (ygg-agent-maps--place (lambda (_s) nil) (car sessions))
            (should (<= (- (float-time) start) 0.4))))
      (when timer (cancel-timer timer))
      (dolist (e (hash-table-values ygg-agent-maps--cache))
        (mapc #'delete-process (plist-get e :procs)))
      (dolist (s sessions) (aob-remove-session s))
      (dolist (r roots) (delete-directory r t))
      (delete-directory tools t))))

(ert-deftest ygg-agent-maps-repeated-edits-on-a-dirty-tree-regenerate ()
  (ygg-agent-maps-tests--with '("features.md")
    (setq ygg-agent-maps-tests--dirty t)
    (let ((file (expand-file-name "x" root)))
      (set-file-times file (seconds-to-time 1000))
      (ygg-agent-maps-refresh root)
      (should (= 1 (ygg-agent-maps-tests--calls-of "ice-repo-map")))
      (ygg-agent-maps-refresh root)
      (should (= 1 (ygg-agent-maps-tests--calls-of "ice-repo-map")))
      (set-file-times file (seconds-to-time 2000))
      (ygg-agent-maps-refresh root)
      (should (= 2 (ygg-agent-maps-tests--calls-of "ice-repo-map")))
      (set-file-times file (seconds-to-time 3000))
      (ygg-agent-maps-refresh root)
      (should (= 3 (ygg-agent-maps-tests--calls-of "ice-repo-map"))))))

