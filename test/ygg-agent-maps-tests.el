;;; ygg-agent-maps-tests.el --- the maps a fresh agent chat is handed -*- lexical-binding: t; -*-

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'aob)
(require 'aob-acp)
(require 'ygg-agent-maps)

(defvar ygg-agent-maps-tests--calls nil)
(defvar ygg-agent-maps-tests--head "aaa")
(defvar ygg-agent-maps-tests--dirty nil)
(defvar ygg-agent-maps-tests--filter t)
(defvar ygg-agent-maps-tests--hang nil)
(defvar ygg-agent-maps-tests--held nil)
(defvar ygg-agent-maps-tests--attr t)
(defvar ygg-agent-maps-tests--toplevel t)
(defvar ygg-agent-maps-tests--hold-summary nil)
(defvar ygg-agent-maps-tests--held-summary nil)

(defconst ygg-agent-maps-tests--marker "<!-- ice-repo-map:generated -->")

(defun ygg-agent-maps-tests--runner (dir argv done &optional _merge)
  (push argv ygg-agent-maps-tests--calls)
  (if ygg-agent-maps-tests--hang
      (push done ygg-agent-maps-tests--held)
    (let ((cmd (file-name-nondirectory (car argv))))
      (cond
       ((and (equal cmd "git") (member "status" argv))
        (funcall done 0 (concat "# branch.oid " ygg-agent-maps-tests--head "\0"
                                (cond ((stringp ygg-agent-maps-tests--dirty)
                                       ygg-agent-maps-tests--dirty)
                                      (ygg-agent-maps-tests--dirty
                                       "1 .M N... 100644 100644 100644 a b x\0")))))
       ((and (equal cmd "git") (member "rev-parse" argv))
        (cond ((stringp ygg-agent-maps-tests--toplevel)
               (funcall done 0 (concat ygg-agent-maps-tests--toplevel "\n")))
              (ygg-agent-maps-tests--toplevel
               (funcall done 0 (concat (directory-file-name dir) "\n")))
              (t (funcall done 128 ""))))
       ((and (equal cmd "git") (member "check-attr" argv))
        (if ygg-agent-maps-tests--attr
            (funcall done 0 "lat.md/lat.md: filter: latgen\n")
          (funcall done 0 "lat.md/lat.md: filter: unspecified\n")))
       ((and (equal cmd "git") (member "config" argv))
        (pcase ygg-agent-maps-tests--filter
          ('old (funcall done 0 "grep -v GENERATED\n"))
          ('nil (funcall done 1 ""))
          (_ (funcall done 0 (format "grep -vF '%s' || true\n"
                                     ygg-agent-maps-tests--marker)))))
       ((equal cmd "ice-repo-map")
        (funcall done 0 (if (member "--write" argv) "" "MAP-BODY\n")))
       ((and (equal cmd "ice-feature-summary") ygg-agent-maps-tests--hold-summary)
        (push done ygg-agent-maps-tests--held-summary))
       ((equal cmd "ice-feature-summary")
        (funcall done 0 "- Feature A: lead\nDetails: query lat_search on [[features]].\n"))
       (t (funcall done 1 ""))))))

(defun ygg-agent-maps-tests--calls-of (name &optional flag)
  (cl-count-if (lambda (argv)
                 (and (equal (file-name-nondirectory (car argv)) name)
                      (if flag (member flag argv) (not (member "--write" argv)))))
               ygg-agent-maps-tests--calls))

(defmacro ygg-agent-maps-tests--with (lat &rest body)
  "Run BODY in a temp git repo whose lat.md holds the files LAT names."
  (declare (indent 1))
  `(let* ((root (file-name-as-directory (file-truename (make-temp-file "ygg-maps-" t))))
          (tools (file-name-as-directory (make-temp-file "ygg-maps-tools-" t)))
          (ygg-agent-maps-tools-dir tools)
          (ygg-agent-maps-interpreter nil)
          (ygg-agent-maps-enabled t)
          (ygg-agent-maps-wait 0.3)
          (ygg-agent-maps-project-budgets nil)
          (ygg-agent-maps--cache (make-hash-table :test #'equal))
          (ygg-agent-maps-tests--calls nil)
          (ygg-agent-maps-tests--head "aaa")
          (ygg-agent-maps-tests--dirty nil)
          (ygg-agent-maps-tests--filter t)
          (ygg-agent-maps-tests--hang nil)
          (ygg-agent-maps-tests--held nil)
          (ygg-agent-maps-tests--attr t)
          (ygg-agent-maps-tests--toplevel t)
          (ygg-agent-maps-tests--hold-summary nil)
          (ygg-agent-maps-tests--held-summary nil))
     (unwind-protect
         (progn
           (with-temp-file (expand-file-name "ice-latgen-filter" tools)
             (insert "#!/bin/sh\nmarker='" ygg-agent-maps-tests--marker "'\n"))
           (with-temp-file (expand-file-name "x" root) (insert "x\n"))
           (dolist (tool '("ice-repo-map" "ice-feature-summary"))
             (let ((f (expand-file-name tool tools)))
               (with-temp-file f (insert "#!/bin/sh\n"))
               (set-file-modes f #o755)))
           (dolist (f ,lat)
             (let ((p (expand-file-name (concat "lat.md/" f) root)))
               (make-directory (file-name-directory p) t)
               (with-temp-file p (insert "x\n"))))
           (cl-letf (((symbol-function 'ygg-agent-maps--run)
                      #'ygg-agent-maps-tests--runner))
             ,@body))
       (delete-directory root t)
       (delete-directory tools t))))

(defun ygg-agent-maps-tests--session (root &rest props)
  (let ((s (aob-create-session :id (format "acp:maps:%s" (random 100000))
                               :backend 'acp :name "maps" :project root
                               :dir root :state 'idle :refs props)))
    s))

(defun ygg-agent-maps-tests--first-block (s)
  (plist-get (aob-acp--place-block s) :text))

(ert-deftest ygg-agent-maps-new-session-first-prompt-has-block ()
  (ygg-agent-maps-tests--with '("features.md" "repo-map.md")
    (let ((s (ygg-agent-maps-tests--session root)))
      (ygg-agent-maps-on-ready s)
      (let ((text (ygg-agent-maps-tests--first-block s)))
        (should (string-match-p "<project-maps>" text))
        (should (string-match-p "MAP-BODY" text))
        (should (string-match-p "Feature A: lead" text))
        (should (string-match-p "lat_search / lat_section on \\[\\[features\\]\\] and \\[\\[repo-map\\]\\]" text))
        (should (= 1 (with-temp-buffer
                       (insert text)
                       (how-many "lat_search" (point-min) (point-max))))))
      (aob-remove-session s))))

(ert-deftest ygg-agent-maps-second-prompt-has-no-block ()
  (ygg-agent-maps-tests--with '("features.md")
    (let ((s (ygg-agent-maps-tests--session root)))
      (ygg-agent-maps-on-ready s)
      (should (ygg-agent-maps-tests--first-block s))
      (aob-set-state s 'working)
      (aob-set-state s 'idle)
      (should-not (string-match-p "project-maps"
                                  (or (ygg-agent-maps-tests--first-block s) "")))
      (aob-remove-session s))))

