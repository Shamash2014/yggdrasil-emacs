;;; magit-review-tests.el --- sending a commit from magit to an agent -*- lexical-binding: t; -*-

;;; Code:

(let ((builds (expand-file-name "../elpaca/builds/"
                                (file-name-directory
                                 (or load-file-name buffer-file-name)))))
  (dolist (p '("magit" "magit-section" "compat" "dash" "llama" "cond-let"
               "transient" "with-editor"))
    (add-to-list 'load-path (expand-file-name p builds))))

(require 'ert)
(require 'cl-lib)
(require 'aob)
(require 'aob-acp)
(require 'magit)
(require 'ygg-magit-review)

(setq aob-acp-persist-file (make-temp-file "magit-review-sessions-" nil ".eld"))
(setq aob-acp-show-trace nil)

(defmacro magit-review-tests--with-repo (vars &rest body)
  "A three-commit temp repo; VARS binds (ROOT HASHES) with HASHES oldest first."
  (declare (indent 1))
  (let ((root (nth 0 vars)) (hashes (nth 1 vars)))
    `(let* ((process-environment
             (append '("GIT_CONFIG_GLOBAL=/dev/null" "GIT_CONFIG_NOSYSTEM=1")
                     process-environment))
            (,root (file-name-as-directory
                    (file-truename (make-temp-file "magit-review-" t))))
            (default-directory ,root)
            (magit-refresh-verbose nil)
            (ygg-magit-review--held (make-hash-table :test #'equal))
            (ygg-magit-review--sent (make-hash-table :test #'equal))
            ,hashes)
       (unwind-protect
           (progn
             (dolist (args '(("init" "-q" "-b" "main")
                             ("config" "user.name" "Review Test")
                             ("config" "user.email" "review@example.invalid")
                             ("config" "commit.gpgsign" "false")))
               (apply #'call-process "git" nil nil nil args))
             (dolist (n '(1 2 3))
               (with-temp-file (expand-file-name (format "f%d.txt" n) ,root)
                 (insert (format "line of file %d\n" n)))
               (call-process "git" nil nil nil "add" ".")
               (call-process "git" nil nil nil "commit" "-q" "-m"
                             (format "subject number %d" n))
               (setq ,hashes
                     (append ,hashes
                             (list (string-trim
                                    (with-output-to-string
                                      (with-current-buffer standard-output
                                        (call-process "git" nil t nil
                                                      "rev-parse" "HEAD"))))))))
             ,@body)
         (dolist (b (buffer-list))
           (when (with-current-buffer b (derived-mode-p 'magit-mode))
             (kill-buffer b)))
         (delete-directory ,root t)))))

(defmacro magit-review-tests--with-sessions (specs &rest body)
  "Register sessions from SPECS, each (ID DIR &optional HIDDEN), around BODY."
  (declare (indent 1))
  `(let ((aob--sessions (make-hash-table :test #'equal))
         (aob--order nil))
     (dolist (spec ,specs)
       (let ((s (aob-create-session :id (car spec) :backend 'acp
                                    :name (car spec) :project (cadr spec)
                                    :state 'idle)))
         (when (nth 2 spec) (aob-session-put s :hidden t))))
     ,@body))

(defun magit-review-tests--goto (text)
  (goto-char (point-min))
  (search-forward text)
  (beginning-of-line))

(ert-deftest magit-review-status-commit-at-point ()
  (magit-review-tests--with-repo (root hashes)
    (with-current-buffer (magit-status-setup-buffer root)
      (magit-review-tests--goto "subject number 2")
      (should (equal (ygg-magit-review--target) (nth 1 hashes))))))

(ert-deftest magit-review-log-commit-at-point ()
  (magit-review-tests--with-repo (root hashes)
    (with-current-buffer (magit-log-setup-buffer (list "main") nil nil)
      (magit-review-tests--goto "subject number 1")
      (should (equal (ygg-magit-review--target) (nth 0 hashes))))))

(ert-deftest magit-review-marked-range ()
  (magit-review-tests--with-repo (root hashes)
    (with-current-buffer (magit-log-setup-buffer (list "main") nil nil)
      (transient-mark-mode 1)
      (magit-review-tests--goto "subject number 3")
      (push-mark (point) t t)
      (magit-review-tests--goto "subject number 2")
      (should (equal (ygg-magit-review--target)
                     (format "%s^..%s" (nth 1 hashes) (nth 2 hashes)))))))

(ert-deftest magit-review-no-commit-refuses ()
  (magit-review-tests--with-repo (root hashes)
    (with-temp-file (expand-file-name "loose.txt" root) (insert "x\n"))
    (with-current-buffer (magit-status-setup-buffer root)
      (magit-review-tests--goto "Untracked files")
      (should (equal (cadr (should-error (ygg-magit-review--target)
                                         :type 'user-error))
                     "No commit at point")))))

(ert-deftest magit-review-prompt-carries-commit ()
  (magit-review-tests--with-repo (root hashes)
    (let ((p (ygg-magit-review-prompt root (nth 1 hashes))))
      (should (string-prefix-p ygg-magit-review-instructions p))
      (should (string-search (nth 1 hashes) p))
      (should (string-search "subject number 2" p))
      (should (string-search "+line of file 2" p))
      (should (string-search "<commit>" p))
      (should-not (string-search "left out" p))
      (should-not (string-search "not in" p)))))

(ert-deftest magit-review-prompt-range-and-elsewhere ()
  (magit-review-tests--with-repo (root hashes)
