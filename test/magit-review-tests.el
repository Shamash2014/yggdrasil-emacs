              root (format "%s^..%s" (nth 1 hashes) (nth 2 hashes)) "/far/away")))
      (should (string-search "<commits>" p))
      (should (string-search "subject number 2" p))
      (should (string-search "subject number 3" p))
      (should-not (string-search "subject number 1" p))
      (should (string-search "+line of file 3" p))
      (should (string-search "You work in /far/away" p)))))

(ert-deftest magit-review-range-from-root-commit ()
  (magit-review-tests--with-repo (root hashes)
