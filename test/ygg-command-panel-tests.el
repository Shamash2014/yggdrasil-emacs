;;; ygg-command-panel-tests.el --- The command panel lists tasks and commands -*- lexical-binding: t; -*-

;;; Code:

(load (expand-file-name "test-isolate" (file-name-directory (or load-file-name buffer-file-name))) nil t)
(require 'ert)
(require 'cl-lib)
(defvar ygg-leader-open-map (make-sparse-keymap))
(require 'layer-tasks)

(unless (fboundp 'ygg-git-ci-snapshot)
  (defun ygg-git-ci-snapshot (&rest _) nil)
  (defun ygg-git-ci-row-mark (row) (symbol-name (plist-get row :state)))
  (defun ygg-git-ci-row-details (&rest _) "1m")
  (defun ygg-git-ci-act (&rest _) nil))

(defun ygg-command-panel-tests--candidates ()
  (let (shown)
    (cl-letf (((symbol-function 'ygg-task--collect)
               (lambda (&rest _) (list (list :label "just: build" :command "just build" :directory "/"))))
              ((symbol-function 'completing-read)
               (lambda (_prompt table &rest _) (setq shown (all-completions "" table)) "")))
      (ignore-errors (ygg-command-panel)))
    shown))

(require 'prescient nil t)
(defvar vertico-sort-function nil)

(defmacro ygg-command-panel-tests--with-prescient (&rest body)
  `(let ((prescient--history (make-hash-table :test 'equal))
         (prescient--frequency (make-hash-table :test 'equal))
         (prescient-persist-mode nil)
         (vertico-sort-function #'prescient-completion-sort))
     ,@body))

(defun ygg-command-panel-tests--sorted (input &optional jobs)
  (let (table)
    (cl-letf (((symbol-function 'ygg--panel-input) (lambda () input))
              ((symbol-function 'ygg-task--collect)
               (lambda (&rest _) (list (list :label "just: build" :command "just build" :directory "/"))))
              ((symbol-function 'ygg--panel-job-buffers) (lambda () jobs))
              ((symbol-function 'completing-read)
               (lambda (_prompt tbl &rest _) (setq table tbl) "")))
      (ignore-errors (ygg-command-panel))
      (let ((sorter (completion-metadata-get (completion-metadata "" table nil) 'display-sort-function))
            (cands (seq-filter (lambda (c) (string-match-p (regexp-quote input) c))
                               (all-completions "" table))))
        (funcall sorter cands)))))

(ert-deftest ygg-command-panel/lists-tasks-first-and-every-command ()
  (let ((shown (ygg-command-panel-tests--candidates)))
    (should (equal (car shown) "▶ run  just: build"))
    (should (member "find-file" shown))))

(ert-deftest ygg-command-panel/specials-precede-commands ()
  (ygg-command-panel-tests--with-prescient
   (let* ((job (generate-new-buffer "panel-job"))
          (sorted (ygg-command-panel-tests--sorted "" (list job))))
     (unwind-protect
         (progn
           (should (equal (seq-take sorted 2) (list "▶ run  just: build" "⚙ job  panel-job")))
           (should (member "find-file" sorted)))
       (kill-buffer job)))))

(ert-deftest ygg-command-panel/remembered-command-ranks-before-untouched ()
  (ygg-command-panel-tests--with-prescient
   (prescient-remember "ygg-task-run")
   (let ((sorted (cdr (ygg-command-panel-tests--sorted ""))))
     (should (equal (car sorted) "ygg-task-run")))))

(ert-deftest ygg-command-panel/typed-input-ranks-like-m-x ()
  (ygg-command-panel-tests--with-prescient
   (prescient-remember "ygg-task-run")
   (let* ((job (generate-new-buffer "*task:build*"))
          (sorted (unwind-protect (ygg-command-panel-tests--sorted "task" (list job))
                    (kill-buffer job)))
          (expected (prescient-completion-sort
                     (cons "⚙ job  *task:build*"
                           (seq-filter (lambda (c) (string-match-p "task" c))
                                       (ygg--panel-commands))))))
     (should (equal (car sorted) "ygg-task-run"))
     (should (equal sorted expected)))))

(ert-deftest ygg-command-panel/job-list-skips-internal-process-buffers ()
  (let* ((hidden (generate-new-buffer " *ygg-device*"))
         (named (generate-new-buffer "*Async-native-compile-log*"))
         (shown (generate-new-buffer "*task:build*"))
         (procs (mapcar (lambda (b) (make-pipe-process :name (buffer-name b) :buffer b :noquery t))
                        (list hidden named shown))))
    (unwind-protect
        (let ((jobs (ygg--panel-job-buffers)))
          (should (memq shown jobs))
          (should-not (memq hidden jobs))
          (should-not (memq named jobs)))
      (mapc #'delete-process procs)
      (mapc #'kill-buffer (list hidden named shown)))))

(ert-deftest ygg-command-panel/groups-project-commands-into-local-and-ci ()
  (let (table)
    (cl-letf (((symbol-function 'ygg-task--collect) (lambda (&rest _) nil))
              ((symbol-function 'ygg--panel-job-buffers) (lambda () nil))
              ((symbol-function 'project-current) (lambda (&rest _) '(transient "/tmp/p/")))
              ((symbol-function 'project-root) (lambda (_) "/tmp/p/"))
              ((symbol-function 'ygg-project-commands-refresh-ci) #'ignore)
              ((symbol-function 'ygg-project-commands)
               (lambda (_) '((:name "build" :source just) (:name "ci: job e2e" :source ci)
                             (:name "ci: new pipeline" :source ci))))
              ((symbol-function 'completing-read)
               (lambda (_prompt tbl &rest _) (setq table tbl) "")))
      (ignore-errors (ygg-command-panel)))
    (let ((group (completion-metadata-get (completion-metadata "" table nil) 'group-function)))
      (should (equal (funcall group "▶ just   build" nil) "Local (1)"))
      (should (equal (funcall group "▶ ci     ci: job e2e" nil) "CI start (2)"))
      (should (equal (funcall group "▶ ci     ci: job e2e" t) "▶ job e2e"))
      (should (equal (funcall group "▶ just   build" t) "▶ just   build"))
      (should-not (funcall group "find-file" nil))
      (should (equal (funcall group "find-file" t) "find-file")))))

(defmacro ygg-command-panel-tests--with-ci (snapshot-var &rest body)
  `(let ((ygg--panel-ci-interval 0) table fetches acts)
     (cl-letf (((symbol-function 'ygg-task--collect) (lambda (&rest _) nil))
               ((symbol-function 'ygg--panel-job-buffers) (lambda () nil))
               ((symbol-function 'project-current) (lambda (&rest _) '(transient "/tmp/p/")))
               ((symbol-function 'project-root) (lambda (_) "/tmp/p/"))
               ((symbol-function 'ygg-project-commands-refresh-ci) #'ignore)
               ((symbol-function 'ygg-project-commands)
                (lambda (_) '((:name "ci: job e2e" :source ci))))
               ((symbol-function 'ygg-git-ci-snapshot)
                (lambda (_root &optional fetch)
                  (when fetch (push t fetches))
                  ,snapshot-var))
               ((symbol-function 'ygg-git-ci-act)
                (lambda (root row) (push (list root row) acts)))
               ((symbol-function 'completing-read)
                (lambda (_prompt tbl &rest _) (setq table tbl) (or (bound-and-true-p picked) ""))))
       ,@body)))

(defvar ygg-command-panel-tests--rows
  (list (list :name "build" :stage "test" :state 'passed :id 1)
        (list :name "deploy" :stage "ship" :state 'failed :id 2)))

(defun ygg-command-panel-tests--group (table cand)
  (funcall (completion-metadata-get (completion-metadata "" table nil) 'group-function) cand nil))

(ert-deftest ygg-command-panel/ci-jobs-and-start-items-are-grouped ()
  (let ((snap (list :key 'k :rows ygg-command-panel-tests--rows :stamp 1)))
    (ygg-command-panel-tests--with-ci snap
      (ignore-errors (ygg-command-panel))
      (let* ((cands (all-completions "" table))
             (job (seq-find (lambda (c) (string-match-p "build" c)) cands))
             (note (funcall (completion-metadata-get (completion-metadata "" table nil)
                                                     'annotation-function)
                            job)))
        (should (equal (ygg-command-panel-tests--group table job) "CI jobs (2)"))
        (should (string-match-p "test" job))
        (should (stringp note))
        (should (equal (ygg-command-panel-tests--group table "▶ ci     ci: job e2e")
                       "CI start (1)"))))))

(ert-deftest ygg-command-panel/selecting-a-job-row-acts-on-that-row ()
  (let ((snap (list :key 'k :rows ygg-command-panel-tests--rows :stamp 1))
        (picked nil))
    (ygg-command-panel-tests--with-ci snap
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (_p tbl &rest _)
                   (setq picked (seq-find (lambda (c) (string-match-p "deploy" c))
                                          (all-completions "" tbl))))))
        (ygg-command-panel))
      (should (equal acts (list (list "/tmp/p/" (cadr ygg-command-panel-tests--rows))))))))

(ert-deftest ygg-command-panel/missing-cache-fetches-and-shows-a-placeholder ()
  (let ((snap (list :key 'k)))
    (ygg-command-panel-tests--with-ci snap
      (ignore-errors (ygg-command-panel))
      (should (= (length fetches) 1))
      (let ((placeholder (seq-find (lambda (c) (string-match-p "fetching" c))
                                   (all-completions "" table))))
        (should placeholder)
        (should (equal (ygg-command-panel-tests--group table placeholder) "CI jobs"))))))

(ert-deftest ygg-command-panel/table-shows-rows-once-the-fetch-lands ()
  (let ((snap (list :key 'k)))
    (ygg-command-panel-tests--with-ci snap
      (ignore-errors (ygg-command-panel))
      (should (seq-find (lambda (c) (string-match-p "fetching" c)) (all-completions "" table)))
      (setq snap (list :key 'k :rows ygg-command-panel-tests--rows :stamp 2))
      (let ((cands (all-completions "" table)))
        (should-not (seq-find (lambda (c) (string-match-p "fetching" c)) cands))
        (should (seq-find (lambda (c) (string-match-p "deploy" c)) cands))))))

(provide 'ygg-command-panel-tests)
;;; ygg-command-panel-tests.el ends here
