      (ygg-git-compare-tests--git root "remote" "add" "origin" remote)
      (ygg-git-compare-tests--git root "push" "-q" "origin" "main" "feature:refs/pull/7/head")
      (ygg-git-compare-tests--git root "fetch" "-q" "origin")
      (let ((branches (ygg-git-compare-tests--git root "branch" "-a"))
            (gh-calls 0))
        (cl-letf (((symbol-function 'ygg-git-compare--gh-repo-url) #'ignore)
                  ((symbol-function 'ygg-git-compare--gh-pulls)
                   (lambda ()
                     (cl-incf gh-calls)
                     '((:number 7 :title "Feature work" :headRefName "feature"
                                :baseRefName "main")))))
          (should-not (rassq 'pr (mapcar (lambda (c) (cons (car c) (cadr c)))
                                         (ygg-git-compare-candidates))))
          (should (= gh-calls 0))
          (let* ((cands (ygg-git-compare-candidates t))
                 (pr (seq-find (lambda (c) (eq (cadr c) 'pr)) cands))
                 (spec (cdr pr)))
