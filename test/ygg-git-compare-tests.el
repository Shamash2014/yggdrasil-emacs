        (should (string-match-p "^\\+untracked" prompt))
        (should-not (string-search "inner" prompt))))))

(ert-deftest ygg-git-compare-review-names-a-remote-checkout-as-its-agent-sees-it ()
  (let ((remote "/ssh:host:/srv/repo/"))
    (with-temp-buffer
      (setq-local ygg-git-compare--a '(:label "main" :diff "aaa" :log "aaa"))
      (setq-local ygg-git-compare--b (list :label "repo [x]" :diff "bbb" :log "bbb"
                                           :dir remote :uncommitted t))
      (setq-local ygg-git-compare--plan (list :work ygg-git-compare--b :dir remote
                                              :range "aaa"))
      (setq-local ygg-git-compare--dots "...")
      (setq-local default-directory remote)
      (cl-letf (((symbol-function 'ygg-git-compare--git) (lambda (&rest _) "")))
        (let ((prompt (ygg-git-compare-review-prompt)))
          (should (string-search "repository /srv/repo/\n" prompt))
          (should (string-search "aaa.../srv/repo/" prompt))
          (should-not (string-search "/ssh:" prompt)))))))

(ert-deftest ygg-git-compare-review-diff-ignores-external-diff-and-color ()
  (ygg-git-compare-tests--with-repo (root tree)
    (let ((ext (expand-file-name "../ext.sh" root)))
      (ygg-git-compare-tests--write ext "#!/bin/sh\necho EXTERNAL\n")
      (set-file-modes ext #o755)
      (ygg-git-compare-tests--git root "config" "diff.external" ext)
      (ygg-git-compare-tests--git root "config" "color.ui" "always"))
    (ygg-git-compare-tests--write (expand-file-name "a.txt" tree) "1\ntwo\n3\ndirty\n")
    (ygg-git-compare-tests--write (expand-file-name "u.txt" tree) "untracked\n")
    (with-current-buffer (ygg-git-compare-buffer root '(rev . "main") (cons 'worktree tree))
      (let ((prompt (ygg-git-compare-review-prompt)))
        (should (string-match-p "^\\+dirty" prompt))
        (should (string-match-p "^\\+untracked" prompt))
        (should-not (string-search "EXTERNAL" prompt))
        (should-not (string-search "\e[" prompt))))))

(ert-deftest ygg-git-compare-pull-request-comes-from-the-repository-gh-lists ()
  (ygg-git-compare-tests--with-repo (root _tree)
    (let ((fork (expand-file-name "../fork.git" root))
          (upstream (expand-file-name "../upstream.git" root))
          (feature (ygg-git-compare-tests--git root "rev-parse" "feature")))
      (ygg-git-compare-tests--git root "init" "-q" "--bare" fork)
      (ygg-git-compare-tests--git root "init" "-q" "--bare" upstream)
      (ygg-git-compare-tests--git root "remote" "add" "origin" fork)
      (ygg-git-compare-tests--git root "remote" "add" "parent" upstream)
      (ygg-git-compare-tests--git root "push" "-q" "origin" "main~1:refs/heads/main")
      (ygg-git-compare-tests--git root "push" "-q" "parent" "main" "feature:refs/pull/7/head")
      (ygg-git-compare-tests--git root "fetch" "-q" "--all")
      (should (equal (ygg-git-compare--url-key "git@GitHub.com:Owner/Repo.git")
                     (ygg-git-compare--url-key "https://github.com/owner/repo/")))
      (cl-letf (((symbol-function 'ygg-git-compare--gh-repo-url)
                 (lambda () (concat "file://" upstream)))
                ((symbol-function 'ygg-git-compare--gh-pulls)
                 (lambda () '((:number 7 :title "Feature work" :headRefName "feature"
                                       :baseRefName "main")))))
        (let ((spec (cdr (seq-find (lambda (c) (eq (cadr c) 'pr))
                                   (ygg-git-compare-candidates t)))))
          (should (equal (plist-get (cdr spec) :remote) "parent"))
          (should (equal (ygg-git-compare-default-a spec) '(rev . "parent/main")))
          (should (equal (plist-get (cdr (ygg-git-compare--prepare spec)) :sha)
                         feature)))))))

(ert-deftest ygg-git-compare-toggle-without-shared-history-changes-nothing ()
  (ygg-git-compare-tests--with-repo (root tree)
    (ygg-git-compare-tests--git tree "checkout" "-q" "--orphan" "pages")
    (ygg-git-compare-tests--git tree "rm" "-rqf" ".")
    (ygg-git-compare-tests--write (expand-file-name "index.html" tree) "<p>\n")
    (ygg-git-compare-tests--git tree "add" "index.html")
    (ygg-git-compare-tests--git tree "commit" "-q" "-m" "pages")
    (ygg-git-compare-tests--write (expand-file-name "index.html" tree) "<p>dirty\n")
    (with-current-buffer (ygg-git-compare-buffer root '(rev . "main") (cons 'worktree tree))
      (let ((range magit-buffer-diff-range)
            (plan ygg-git-compare--plan)
            (label (ygg-git-compare--range-label)))
        (should (equal ygg-git-compare--dots ".."))
        (should-error (ygg-git-compare-toggle-dots) :type 'user-error)
        (should (equal ygg-git-compare--dots ".."))
        (should (eq ygg-git-compare--plan plan))
        (should (equal magit-buffer-diff-range range))
        (should (equal (ygg-git-compare--range-label) label))
        (ygg-git-compare--header)
        (should (string-search "A..B" (format "%s" header-line-format)))))))

(ert-deftest ygg-git-compare-url-key-leaves-out-the-port ()
  (dolist (url '("ssh://git@h.example:2222/g/p.git" "https://h.example:8443/g/p.git"
                 "git@H.example:g/p.git" "https://h.example/g/p/"))
    (should (equal (ygg-git-compare--url-key url) "h.example/g/p"))))

