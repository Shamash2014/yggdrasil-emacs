(defmacro ygg-git-compare-tests--with-sessions (specs &rest body)
  "Register sessions from SPECS, each (ID DIR), around BODY."
  (declare (indent 1))
  `(let ((aob--sessions (make-hash-table :test #'equal))
         (aob--order nil))
     (dolist (spec ,specs)
       (aob-create-session :id (car spec) :backend 'acp :name (car spec)
                           :project (cadr spec) :state 'idle))
     ,@body))

(defun ygg-git-compare-tests--goto (text)
  (goto-char (point-min))
  (search-forward text)
  (beginning-of-line))

(defun ygg-git-compare-tests--comment (text)
  "Comment TEXT on the diff line at point, written in the comment buffer."
  (with-current-buffer (ygg-git-compare-comment)
    (insert text)
    (ygg-git-compare-draft-save)))

(defmacro ygg-git-compare-tests--with-compare (root &rest body)
  "BODY in a compare of main against feature, every hunk shown."
  (declare (indent 1))
  `(with-current-buffer (ygg-git-compare-buffer ,root '(rev . "main") '(rev . "feature"))
     (magit-section-show-level-4-all)
     ,@body))

