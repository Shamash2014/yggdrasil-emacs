(ert-deftest ygg-git-worktree-dead-buffer-while-pending-is-harmless ()
  (ygg-git-worktree-tests--with-repo (outer root)
    (ygg-git-worktree-tests--add root outer 4)
    (let ((buf (generate-new-buffer " *wt-dead*")))
      (with-current-buffer buf
        (magit-status-mode)
        (setq default-directory root)
        (ygg-git-worktree-tests--reset)
        (ygg-git-worktree-tests--render root))
      (kill-buffer buf)
      (ygg-git-worktree-tests--drain)
      (should (zerop ygg-git-worktree--running))
      (should (= (hash-table-count ygg-git-worktree--cache) 5)))))

(ert-deftest ygg-git-worktree-request-during-a-job-reruns-with-the-newer-fingerprint ()
  (ygg-git-worktree-tests--with-repo (outer root)
    (ygg-git-worktree-tests--status root
      (let ((dir (directory-file-name root)))
        (ygg-git-worktree--request dir '("old"))
        (ygg-git-worktree--pump)
        (ygg-git-worktree--request dir '("new"))
        (ygg-git-worktree-tests--drain)
        (should (= (length spawned) 2))
        (should (equal (plist-get (gethash dir ygg-git-worktree--cache) :fp) '("new")))
        (should (zerop ygg-git-worktree--running))))))

(ert-deftest ygg-git-worktree-hung-status-times-out-and-frees-the-queue ()
  (ygg-git-worktree-tests--with-repo (outer root)
    (ygg-git-worktree-tests--add root outer 4)
    (let* ((real (executable-find "git"))
           (fake (expand-file-name "fake-git" outer))
           (magit-git-executable fake)
           (ygg-git-worktree-status-timeout 0.5)
           (ygg-git-worktree-status-jobs 2))
      (with-temp-file fake
        (insert (format "#!/bin/sh\ncase \"$*\" in *status*) exec sleep 30;; esac\nexec %s \"$@\"\n" real)))
      (set-file-modes fake #o755)
      (ygg-git-worktree-tests--status root
        (ygg-git-worktree-tests--render root)
        (should (= ygg-git-worktree--running 2))
        (ygg-git-worktree-tests--drain)
        (should (zerop ygg-git-worktree--running))
        (should (= (length spawned) 5))
        (should (= (hash-table-count ygg-git-worktree--inflight) 0))
        (should (cl-every (lambda (k)
                            (eq (plist-get (gethash k ygg-git-worktree--cache) :counts) :unknown))
                          (hash-table-keys ygg-git-worktree--cache)))
        (should (= (cl-count ?… (buffer-string)) 5))))))

(ert-deftest ygg-git-worktree-timeout-keeps-the-old-counts ()
  (ygg-git-worktree-tests--reset)
  (puthash "/w" (list :fp '(a) :counts '(1 0 0 nil nil) :at 0) ygg-git-worktree--cache)
  (puthash "/w" (cons '(b) '(b)) ygg-git-worktree--inflight)
  (ygg-git-worktree--abandon "/w")
  (should (equal (plist-get (gethash "/w" ygg-git-worktree--cache) :counts) '(1 0 0 nil nil)))
  (should (= (hash-table-count ygg-git-worktree--inflight) 0)))

(ert-deftest ygg-git-worktree-remote-uses-the-remote-git-and-skips-file-attributes ()
  (let ((magit-git-executable "/local/git")
        (magit-remote-git-executable "remote-git")
        (command nil)
        (handler nil))
    (ygg-git-worktree-tests--reset)
    (cl-letf (((symbol-function 'file-remote-p) (lambda (&rest _) "/ssh:h:"))
              ((symbol-function 'file-attributes) (lambda (&rest _) (error "sync stat")))
              ((symbol-function 'make-process)
               (lambda (&rest args)
                 (setq command (plist-get args :command)
                       handler (plist-get args :file-handler))
                 nil)))
      (should (equal (ygg-git-worktree--fingerprint "/ssh:h:/w" "abc") '("abc")))
      (ygg-git-worktree--spawn "/ssh:h:/w" '("abc"))
      (should (equal (car command) "remote-git"))
      (should handler))))

(ert-deftest ygg-git-worktree-unreachable-commit-blanks-only-itself ()
  (ygg-git-worktree-tests--with-repo (outer root)
    (ygg-git-worktree-tests--reset)
    (let ((good (ygg-git-worktree-tests--git root "rev-parse" "main"))
          (bad (make-string 40 ?d)))
      (ygg-git-worktree--load-commits (list good bad))
      (should (equal (cadr (gethash good ygg-git-worktree--commits)) "base"))
      (should (gethash bad ygg-git-worktree--commits))
      (let ((calls 0)
            (real (symbol-function 'magit-git-lines)))
        (cl-letf (((symbol-function 'magit-git-lines)
                   (lambda (&rest args) (cl-incf calls) (apply real args))))
          (ygg-git-worktree--load-commits (list good bad)))
        (should (zerop calls)))
      (should (string-match-p "detached .*" (ygg-git-worktree--head (list "/x" bad nil nil) "/y"))))))

(ert-deftest ygg-git-worktree-parse-list-records ()
  (let ((wts (ygg-git-worktree--parse-list
              '("worktree /r/main" "HEAD aaa" "branch refs/heads/main"
                "worktree /r/with space/wt" "HEAD bbb" "detached"
                "locked in use on usb"
                "worktree /r/gone" "HEAD ccc" "branch refs/heads/gone"
                "locked" "prunable gitdir file points to non-existent location"))))
    (should (equal wts '(("/r/main" "aaa" "main" nil nil nil nil)
                         ("/r/with space/wt" "bbb" nil nil t "in use on usb" nil)
                         ("/r/gone" "ccc" "gone" nil nil t
                          "gitdir file points to non-existent location"))))))

(ert-deftest ygg-git-worktree-parse-list-bare-falls-back ()
  (should-not (ygg-git-worktree--parse-list '("worktree /r/bare.git" "bare" "worktree /r/wt" "HEAD a" "detached"))))

