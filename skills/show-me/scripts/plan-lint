#!/usr/bin/env python3
# Lint idea after html-plan (Thariq Shihipar, MIT); format: skills/show-me/references/plan.md.
import os, re, subprocess, sys

SPECIAL = ("Shared", "Not changing", "Done")
HEAD = re.compile(r"^(#{1,6})\s+(.*?)\s*$")
NUM = re.compile(r"^(\d+(?:\.\d+)*)\.?\s+(.*)$")
WHERE = re.compile(r"^`([^`]+):(\d+) · ([^`]+)`$")
OPT = re.compile(r"^([a-z])\)\s+(.+?)\s+-\s+(\S.*)$")
PICK = re.compile(r"^pick:\s*([a-z])\s+-\s+(\S.*)$")
FENCE = re.compile(r"^(`{3,}|~{3,})(.*)$")
LINES = re.compile(r"(\d+)(?:-(\d+))?")


def main(argv):
    try:
        return lint(argv)
    except Exception as e:
        print(f"plan-lint: {e}", file=sys.stderr)
        return 2


def lint(argv):
    args = argv[1:]
    root = None
    if "--root" in args:
        i = args.index("--root")
        root = args[i + 1] if i + 1 < len(args) else None
        del args[i:i + 2]
    if len(args) != 1 or root is None and "--root" in argv:
        print("usage: plan-lint FILE [--root DIR]", file=sys.stderr)
        return 2
    path = args[0]
    if root is None:
        d = os.path.dirname(os.path.abspath(path))
        try:
            root = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"],
                                  capture_output=True, text=True, check=True).stdout.strip()
        except Exception:
            root = os.getcwd()
    root = os.path.realpath(root)
    with open(path, encoding="utf-8") as f:
        lines = f.read().split("\n")
    L = Linter(path, root, lines)
    L.run()
    return L.report()


class Linter:
    def __init__(self, path, root, lines):
        self.path, self.root, self.lines = path, root, lines
        self.out = []
        self.cache = {}

    def err(self, n, msg):
        self.out.append((n, "error", msg))

    def warn(self, n, msg):
        self.out.append((n, "warning", msg))

    def file_len(self, rel):
        full = os.path.realpath(os.path.join(self.root, rel))
        if not (full == self.root or full.startswith(self.root + os.sep)) or not os.path.isfile(full):
            return None
        if full not in self.cache:
            with open(full, encoding="utf-8", errors="replace") as f:
                self.cache[full] = sum(1 for _ in f)
        return self.cache[full]

    def scan(self):
        items = []
        fence = None
        start = 0
        if self.lines and self.lines[0].strip() == "---":
            for i in range(1, len(self.lines)):
                if self.lines[i].strip() == "---":
                    start = i + 1
                    break
        for i in range(start, len(self.lines)):
            line = self.lines[i]
            n = i + 1
            if fence:
                if re.match(r"^%s{%d,}\s*$" % (re.escape(fence[0][0]), len(fence[0])), line):
                    items.append(("fence", fence[1], fence[2], n))
                    fence = None
                continue
            m = FENCE.match(line)
            if m:
                fence = (m.group(1), m.group(2).strip(), n)
                continue
            m = HEAD.match(line)
            if m:
                items.append(("head", len(m.group(1)), m.group(2), n))
            else:
                items.append(("line", line, None, n))
        if fence:
            self.err(fence[2], "fence is never closed")
        return items

    def run(self):
        items = self.scan()
        i = 0
        while i < len(items) and items[i][0] == "line" and not items[i][1].strip():
            i += 1
        if i >= len(items) or not (items[i][0] == "head" and items[i][1] == 1):
            n = items[i][3] if i < len(items) else 1
            self.err(n, "first content must be the `#` title")
            return
        title = items[i][2]
        tn = items[i][3]
        words = len(title.split())
        if not 3 <= words <= 7:
            self.err(tn, f"title is {words} words; must be 3 to 7")
        i += 1
        while i < len(items) and items[i][0] == "line" and not items[i][1].strip():
            i += 1
        if not (i < len(items) and items[i][0] == "line" and items[i][1].startswith(">")):
            self.err(tn, "title must be followed by a `>` quote of the owner's words")

        sections = []
        cur = None
        for it in items[i:]:
            if it[0] == "head":
                if it[1] == 1:
                    self.err(it[3], "second `#` title")
                    continue
                cur = {"level": it[1], "text": it[2], "n": it[3], "body": []}
                sections.append(cur)
            elif cur is not None:
                cur["body"].append(it)

        stack = []
        counts = {}
        last = {}
        claims = 0
        qtotal = 0
        seen = {s: None for s in SPECIAL}
        for s in sections:
            lvl, text, n = s["level"], s["text"], s["n"]
            if lvl == 2 and text in SPECIAL:
                seen[text] = s
                stack = []
                if text == "Done" and not any(b[0] == "fence" for b in s["body"]):
                    self.err(n, "## Done must hold a runnable fence")
                self.no_review(s)
                continue
            m = NUM.match(text)
            if lvl > 4:
                self.err(n, "claims go at most 3 levels deep (`##`, `###`, `####`)")
                continue
            if not m:
                self.err(n, "claim heading must be numbered like `1.` / `1.1` / `1.1.1`")
                continue
            num, rest = m.group(1), m.group(2)
            parts = num.split(".")
            depth = lvl - 1
            if len(parts) != depth:
                self.err(n, f"number {num} does not fit a `{'#' * lvl}` heading")
                continue
            claims += 1
            while stack and stack[-1][0] >= depth:
                stack.pop()
            if depth > 1 and (not stack or stack[-1][0] != depth - 1):
                self.err(n, "heading level skips a level")
            else:
                if depth > 1:
                    parent = stack[-1][1]
                    if parts[:-1] != parent.split("."):
                        self.err(n, f"number {num} is not under {parent}")
                key = ".".join(parts[:-1])
                expect = last.get(key, 0) + 1
                if int(parts[-1]) != expect:
                    self.err(n, f"number {num} is out of order; expected {key + '.' if key else ''}{expect}")
                last[key] = int(parts[-1])
                counts[key] = counts.get(key, 0) + 1
                if counts[key] == 6:
                    self.err(n, f"claim {key} has more than 5 children" if key else "plan has more than 5 level-1 claims")
            stack.append((depth, num))
            self.claim(s, depth, num, rest)
            qtotal += self.reviews(s, depth)
        if claims == 0:
            self.err(tn, "plan has no claims")
        for name in ("Not changing", "Done"):
            if seen[name] is None:
                self.err(tn, f"missing `## {name}`")
        if qtotal == 0:
            self.warn(tn, "plan has no Review block; ask only if a fork changes what gets built")
        elif qtotal > 5:
            self.err(tn, f"{qtotal} questions; at most 5 per plan")

    def no_review(self, s):
        for b in s["body"]:
            if b[0] == "line" and b[1].startswith("Q:"):
                self.err(b[3], "Review block must sit on a claim")

    def claim(self, s, depth, num, rest):
        n = s["n"]
        fences = [b for b in s["body"] if b[0] == "fence"]
        if len(fences) != 1:
            self.err(n, f"claim {num} has {len(fences)} fences; must have exactly 1")
        if depth <= 2:
            w = len(rest.split())
            if w > 12:
                self.err(n, f"claim {num} is {w} words; at most 12")
        if depth == 3:
            m = WHERE.match(rest)
            if not m:
                self.err(n, f"claim {num} must be `path:line · symbol`")
            else:
                rel, line = m.group(1), int(m.group(2))
                ln = self.file_len(rel)
                if ln is None:
                    self.err(n, f"{rel} does not exist under the root")
                elif line < 1 or line > ln:
                    self.err(n, f"{rel}:{line} is beyond the file's {ln} lines")
        for f in fences:
            info = f[1]
            sm = re.search(r"""\bsrc=(["'])(.*?)\1""", info)
            if sm:
                src = sm.group(2)
                ln = self.file_len(src)
                if ln is None:
                    self.err(f[2], f"src {src} does not exist under the root")
                else:
                    lm = re.search(r"""\blines=(["'])(.*?)\1""", info)
                    rng = LINES.fullmatch(lm.group(2)) if lm else None
                    if lm and not rng:
                        self.err(f[2], f'lines="{lm.group(2)}" must be `a-b` or one line number')
                    elif rng:
                        a = int(rng.group(1))
                        b = int(rng.group(2) or a)
                        if a < 1 or a > b or b > ln:
                            self.err(f[2], f'lines="{a}-{b}" is outside {src} ({ln} lines)')

    def reviews(self, s, depth):
        body = s["body"]
        fence_end = next((b[3] for b in body if b[0] == "fence"), None)
        count = 0
        k = 0
        while k < len(body):
            b = body[k]
            if b[0] == "line" and b[1].startswith("Q:"):
                count += 1
                if fence_end is None or b[3] < fence_end:
                    self.err(b[3], "Review block must come after the claim's exhibit")
                q = b[1][2:].strip()
                if not q or len(q.split()) > 15:
                    self.err(b[3], "question must be 1 to 15 words")
                k += 1
                opts = []
                while k < len(body) and body[k][0] == "line" and OPT.match(body[k][1]):
                    opts.append(OPT.match(body[k][1]).group(1))
                    k += 1
                if not 2 <= len(opts) <= 3:
                    self.err(b[3], f"Review has {len(opts)} options; must be 2 or 3 as `a) X - Y`")
                elif opts != [chr(97 + j) for j in range(len(opts))]:
                    self.err(b[3], "Review options must be lettered a, b, c in order")
                pm = PICK.match(body[k][1]) if k < len(body) and body[k][0] == "line" else None
                if not pm:
                    self.err(b[3], "Review must end with `pick: <letter> - why`")
                else:
                    if pm.group(1) not in opts:
                        self.err(body[k][3], f"pick {pm.group(1)} is not an option")
                    k += 1
                continue
            k += 1
        return count

    def report(self):
        self.out.sort(key=lambda x: x[0])
        for n, kind, msg in self.out:
            print(f"{self.path}:{n}: {kind}: {msg}")
        e = sum(1 for o in self.out if o[1] == "error")
        w = len(self.out) - e
        print(f"{self.path}: {e} error{'s' if e != 1 else ''}, {w} warning{'s' if w != 1 else ''}")
        return 1 if e else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
